[mysqld]
# Tuned for a small single-purpose host, where the memory budget belongs to the
# ViPER desktops rather than to the database. An idle desktop is around 480MB,
# so every 100MB reclaimed here is a meaningful fraction of another session.
default_authentication_plugin = mysql_native_password
skip-log-bin

# Off by default in this deployment: it costs hundreds of megabytes of instrumentation
# for data nobody reads on a demo appliance.
performance_schema = OFF

# Connection Settings
max_connections = 50
connect_timeout = 10
wait_timeout = 600

# Memory Settings
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_sort_buffer_size = 256K

# MyISAM Settings
key_buffer_size = 8M
myisam_sort_buffer_size = 512K

# Table Cache
table_open_cache = 400
table_definition_cache = 400

# Thread Settings
thread_cache_size = 8
thread_stack = 256K
