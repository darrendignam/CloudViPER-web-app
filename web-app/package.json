{
  "name": "viper-cloud-web-gui",
  "version": "2.0.0-alpha.0",
  "description": "Container orchestrator app for the Cloud Viper project",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "NODE_ENV=dev ts-node-dev --respawn --transpile-only src/app.ts",
    "compile": "tsc",
    "build": "gulp build",
    "build_npm": "tsc && npm run copy-views",
    "copy-views": "copyfiles -u 1 'src/views/**/*' 'src/views/*' 'dist/views'",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watchAll",
    "coverage": "jest --coverage",
    "logs:session": "node scripts/view-session-logs.js",
    "logs:app": "tail -f logs/app-$(date +%Y-%m-%d).log",
    "logs:sql": "tail -f logs/sql-$(date +%Y-%m-%d).log"
  },
  "author": "Darren Dignam",
  "license": "Apache-2.0",
  "dependencies": {
    "@dr.pogodin/csurf": "^1.13.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "bcrypt-nodejs": "^0.0.3",
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "dockerode": "^4.0.2",
    "dotenv": "10.0.0",
    "express": "^4.21.1",
    "express-handlebars": "^8.0.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "mailersend": "^2.6.0",
    "memorystore": "^1.6.7",
    "mysql2": "^3.10.3",
    "nodemailer": "^6.9.15",
    "nodemon": "^3.1.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-local-sequelize": "^0.9.1",
    "sequelize": "^6.37.3",
    "sequelize-mock": "^0.10.2",
    "sqlite3": "^5.1.7",
    "util": "^0.12.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/dockerode": "^3.3.35",
    "@types/express": "^5.0.0",
    "@types/express-mysql-session": "^3.0.6",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.2",
    "@types/winston": "^2.4.4",
    "del": "^8.0.0",
    "gulp": "^5.0.0",
    "gulp-copy": "^5.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "sequelize-test-helpers": "^1.4.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
