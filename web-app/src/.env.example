MYSQL_ROOT_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]
MYSQL_DATABASE=[[DATABASE_NAME]]
MYSQL_USER=[[DATABASE_USER]]
MYSQL_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]

DB_HOST=mysqldb-viper-cloud
DB_PORT=3306
DB_USER=[[DATABASE_USER]]
DB_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]
DB_NAME=[[DATABASE_NAME]]

# Outgoing email. Without it, invitations and password resets are not delivered
# and the app says so at boot. The sender address is no-reply@$DOMAIN_NAME, so
# that domain has to be verified in MailerSend (SPF and DKIM records) or the
# provider rejects the send.
MAILERSEND_API_KEY=[[YOUR_API_KEY]]

# Google sign-in is optional; leave both blank to run on local accounts only.
# The authorised redirect URI registered with Google must match exactly,
# trailing slash included:  https://$DOMAIN_NAME/account/google/return/
GOOGLE_AUTH_CLIENT_ID=[[YOUR_CLIENT_ID]]
GOOGLE_AUTH_CLIENT_SECRET=[[YOUR_CLIENT_SECRET]]

PORT=3000
APP_COOKIE_SECRET=[[YOUR_APP_COOKIE_SECRET]]
# The zone desktops live under. Each instance is created as <uuid>.$APP_HOST,
# so whatever is set here must be covered by the wildcard certificate Traefik
# holds, and by a wildcard DNS record pointing at this host.
APP_HOST=[[HOSTNAME_OR_SUBDOMAIN]]

# The host the application itself answers on. Usually the same zone apex.
DOMAIN_NAME=[[HOSTNAME_OR_SUBDOMAIN]]

NODE_ENV=dev

# --- ViPER instance containers (2.0.0, Selkies) ---
# Image CloudViPER launches for each desktop. ViPER v2.0.0-alpha builds on
# ghcr.io/linuxserver/baseimage-selkies (Ubuntu 26.04).
VIPER_IMAGE=ghcr.io/darrendignam/opf-cloud-viper:2.0.0-alpha

# Host directory bind-mounted read-only into each instance at /config/test-corpus
TEST_CORPUS_HOST_PATH=/var/viper-docker-project/volumes/test-corpus/test-root/corpora

# Selkies in-container token control plane. Never publish this port: it binds
# 0.0.0.0 inside the container and its bearer token grants desktop access.
SELKIES_CONTROL_PORT=8083
SELKIES_CONTROL_TIMEOUT_MS=5000

# Container image pool (2.1)
#
# VIPER_IMAGE is now the bottom of a chain, not the only answer: an explicit
# choice, then the team default, then the system default, then this. An
# installation that never touches the pool behaves exactly as it did before.
#
# IMAGE_BLOCKLIST adds to the built-in list of images that may never be run as a
# desktop nor removed through the pool UI. Comma separated, matched as a
# case-insensitive substring. The built-in entries cover the CloudViPER app
# itself, MySQL and the proxy: deleting one of those takes the platform down.
# IMAGE_BLOCKLIST=internal-registry-thing,another-one

# Ingress (2.1)
#
# Traefik reads routing from container labels and watches one Docker network.
# Instances are given labels naming this resolver and are attached to this
# network; neither is read in development, where the app talks to containers
# through published ports instead.
#
# The resolver serves a wildcard, so no instance performs its own ACME
# exchange. That is why the old ACME_PRE_HOOK and ACME_POST_HOOK variables are
# gone: there is no per-instance certificate to wait for.
# INGRESS_NETWORK=cloudviper_ingress
# TRAEFIK_CERT_RESOLVER=letsencrypt
# INSTANCE_ACTIVATION_DELAY_MS=5000

# Email domains whose members are created as system administrators on first
# Google sign-in. Comma separated. This hands system administration to whoever
# controls mail for these domains, so keep it to domains you run.
# ADMIN_EMAIL_DOMAINS=openpreservation.org

# Who outgoing mail comes from, when that differs from where the app lives.
# A provider only sends as a domain verified with it, which is DNS work on the
# sending domain, so an appliance on a new host can send as an established
# domain while every link in the message still points at DOMAIN_NAME.
# MAIL_FROM_DOMAIN=cloudviper.org
# MAIL_FROM_ADDRESS=no-reply@cloudviper.org

# Shared files offered to desktops (2.1)
#
# The only directory instances may be given, and the whole point of the feature:
# mount an SMB or NFS export on the host underneath it and its subdirectories
# become offerable to desktops through the admin interface, without anything
# being copied or built into a 10GB image.
#
# Deliberately nowhere near the application's own directory tree, which holds
# the MySQL data directory and this file. Namespaced under /mnt rather than
# being /mnt itself, so putting something here is a deliberate act rather than a
# side effect of mounting a disk.
#
# docker-compose bind-mounts this read-only into the application at the same
# path. That has to stay identical inside and out: the application resolves and
# checks a path while the Docker daemon acts on it, so if the two disagreed a
# check that passed here would mount something else there.
# INSTANCE_VOLUME_ROOT=/mnt/cloudviper
