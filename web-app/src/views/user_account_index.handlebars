<div class="cloud-page">
    <!-- User Account Dashboard Cloud -->
    <div class="login-cloud">
        <h1>Welcome to CloudViPER</h1>
        <p>Your digital preservation journey starts here</p>

        {{#if alertSuccess}}
            {{#ifNotEquals alertSuccess ""}}
            <div class="success-alert">
                <p>{{alertSuccess}}</p>
            </div>
            {{/ifNotEquals}}
        {{/if}}

        <div class="login-content">
            <div class="login-form">
                <h2>Your Account Details</h2>
                
                <div class="account-info">
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-user"></i> Username:</span>
                        <span class="info-value">{{user.username}}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-envelope"></i> Email:</span>
                        <span class="info-value">{{user.email}}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-shield-alt"></i> Account Type:</span>
                        <span class="info-value role-badge user-role">{{user.role}} Account</span>
                    </div>
                </div>

                <div class="upgrade-section">
                    <h3>🚀 Ready to Unlock Full Access?</h3>
                    <p>Your account is currently limited. Contact an admin to upgrade and gain access to powerful digital preservation tools!</p>
                    
                    <a href="mailto:admin@cloudviper.org?subject=Account Upgrade Request&body=Hello, I would like to upgrade my CloudViPER account. My username is: {{user.username}}" class="google-btn upgrade-btn">
                        <i class="fas fa-rocket"></i> Request Account Upgrade
                    </a>
                </div>
            </div>
            
            <div class="welcome-text">
                <h2>CloudViPER Benefits</h2>
                <p>You're just one step away from accessing the most comprehensive digital preservation platform available. Once upgraded, you'll have full access to validation tools, file analysis, and preservation workflows.</p>
                <p>Our cloud-based solution ensures your digital assets are processed securely with enterprise-grade protection and comprehensive audit trails.</p>
            </div>
        </div>
    </div>

    <!-- Upgrade Benefits Section -->
    <div class="info-section">
        <div class="info-column">
            <h3><i class="fas fa-tools" style="color: #87CEEB;"></i> Access ViPER Tools</h3>
            <p>Unlock powerful digital preservation tools including file validation, format identification, and metadata extraction. Process your files with confidence using industry-standard preservation workflows.</p>
        </div>
        <div class="info-column">
            <h3><i class="fas fa-cloud-upload-alt" style="color: #137DA4;"></i> Upload & Analyze</h3>
            <p>Upload your digital files for comprehensive analysis and validation. Get detailed reports on file integrity, format compliance, and preservation recommendations.</p>
        </div>
        <div class="info-column">
            <h3><i class="fas fa-chart-line" style="color: #20B2AA;"></i> Advanced Features</h3>
            <p>Access advanced preservation features, batch processing capabilities, and detailed analytics. Monitor your digital preservation activities with comprehensive reporting.</p>
        </div>
    </div>

    <!-- Current Limitations Section -->
    <div class="upgrade-cta-section">
        <div class="container text-center">
            <h2>What You're Missing Out On</h2>
            <div class="row">
                <div class="col-md-3">
                    <div class="limitation-card">
                        <i class="fas fa-lock" style="color: #cccccc; font-size: 2em;"></i>
                        <h4>File Processing</h4>
                        <p>Currently: Limited Access<br><strong>Upgraded:</strong> Full file processing capabilities</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="limitation-card">
                        <i class="fas fa-database" style="color: #cccccc; font-size: 2em;"></i>
                        <h4>Storage & History</h4>
                        <p>Currently: View only<br><strong>Upgraded:</strong> Full storage and processing history</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="limitation-card">
                        <i class="fas fa-cogs" style="color: #cccccc; font-size: 2em;"></i>
                        <h4>Advanced Tools</h4>
                        <p>Currently: Basic access<br><strong>Upgraded:</strong> Full suite of preservation tools</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="limitation-card">
                        <i class="fas fa-users" style="color: #cccccc; font-size: 2em;"></i>
                        <h4>Priority Support</h4>
                        <p>Currently: Community support<br><strong>Upgraded:</strong> Priority technical assistance</p>
                    </div>
                </div>
            </div>
            <div style="margin-top: 30px;">
                <a href="mailto:admin@cloudviper.org?subject=Account Upgrade Request&body=Hello, I would like to upgrade my CloudViPER account to gain full access to digital preservation tools. My username is: {{user.username}} and my email is: {{user.email}}" class="google-btn large-upgrade-btn">
                    <i class="fas fa-star"></i> Upgrade My Account Now
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.account-info {
    background: rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
}

