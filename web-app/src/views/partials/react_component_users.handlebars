class UserList extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      users: [],
      teams: [],
      isLoading: true,
      error: null,
      newUserEmail: '',
      newUserRole: 'member',
      newUserTeam: props.userTeam || 'none',
      isCreatingTeamAdmin: false,
    };
  }

  componentDidMount() {
    this.fetchUsers();
    if (this.props.userRole === 'admin') {
      this.fetchTeams();
    }
  }

  fetchTeams = () => {
    fetch('/account/teams')
      .then((response) => response.json())
      .then((teams) => this.setState({ teams }))
      .catch((error) => console.error('Error fetching teams:', error));
  };

  handleRoleChange = (userId, newRole) => {
    fetch(`/account/users/${userId}/role`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ role: newRole }),
    })
      .then((response) => response.json())
      .then((data) => {
        console.log('Role update response:', data);
        this.fetchUsers();
      })
      .catch((error) => {
        console.error('Error updating role:', error);
        alert('Error updating role: ' + error.message);
      });
  };

  handleTeamChange = (userId, newTeam) => {
    fetch(`/account/users/${userId}/team`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ team: newTeam }),
    })
      .then((response) => response.json())
      .then((data) => {
        console.log('Team update response:', data);
        this.fetchUsers();
      })
      .catch((error) => {
        console.error('Error updating team:', error);
        alert('Error updating team: ' + error.message);
      });
  };


  fetchUsers = () => {
    this.setState({ isLoading: true });
    fetch('/account/users')
      .then((response) => response.json())
      .then((data) => this.setState({ users: data, isLoading: false }))
      .catch((error) => this.setState({ error, isLoading: false }));
  };
  
  handleInviteUser = () => {
    const { newUserEmail, newUserRole, newUserTeam } = this.state;
    const { userRole } = this.props;
    
    const requestBody = { 
      email: newUserEmail, 
      role: newUserRole 
    };
    
    // Only include team if admin is explicitly setting it
    if (userRole === 'admin' && newUserTeam && newUserTeam !== 'none') {
      requestBody.team = newUserTeam;
    }
    
    fetch('/account/users/invite', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(requestBody),
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.message) {
          alert(data.message);
        }
        this.setState({
          newUserEmail: '',
          newUserRole: 'member',
          newUserTeam: this.props.userTeam || 'none',
          isCreatingTeamAdmin: false,
        });
        this.fetchUsers();
        // Refresh teams list in case a new team was created
        if (this.props.userRole === 'admin') {
          this.fetchTeams();
        }
      })
      .catch((error) => {
        console.error('Error inviting user:', error);
        alert('Error inviting user: ' + error.message);
      });
  };

  getAllRoles = () => {
    return [
      { value: 'user', label: 'User' },
      { value: 'testing', label: 'Testing' },
      { value: 'member', label: 'Member' },
      { value: 'team_leader', label: 'Team Leader' },
      { value: 'team_admin', label: 'Team Admin' },
      { value: 'subscriber', label: 'Subscriber' },
      { value: 'admin', label: 'Admin' },
    ];
  };

  getAvailableRolesForInvite = () => {
    const { userRole } = this.props;
    
    if (userRole === 'admin') {
      return this.getAllRoles();
    } else if (userRole === 'team_admin') {
      return [
        { value: 'user', label: 'User' },
        { value: 'member', label: 'Member' },
        { value: 'team_leader', label: 'Team Leader' },
      ];
    } else if (userRole === 'team_leader') {
      return [
        { value: 'member', label: 'Member' },
      ];
    }
    return [];
  };

  getAvailableRolesForEdit = (user) => {
    const { userRole } = this.props;
    
    if (userRole === 'admin') {
      return this.getAllRoles();
    } else if (userRole === 'team_admin') {
      return [
        { value: 'user', label: 'User' },
        { value: 'member', label: 'Member' },
        { value: 'team_leader', label: 'Team Leader' },
      ];
    } else if (userRole === 'team_leader') {
      return [
        { value: 'member', label: 'Member' },
      ];
    }
    return [];
  };

  // Two users with no team are not colleagues. userTeam is null when the
  // signed-in user has no team, and comparing null to null would otherwise
  // offer edit controls over every teamless account in the system. The server
  // refuses those edits regardless; showing the buttons is still wrong.
  sharesTeamWith = (user) => {
    const { userTeam } = this.props;
    return !!userTeam && !!user.team && user.team === userTeam;
  };

  canEditUser = (user) => {
    const { userRole, currentUserId } = this.props;
    if (userRole === 'admin') {
      return true;
    }
    if (userRole === 'team_admin') {
      // Team admin cannot edit their own role
      return this.sharesTeamWith(user) && user.id !== currentUserId;
    }
    if (userRole === 'team_leader') {
      // Team leaders can only manage members, not other team leaders or team admins
      return this.sharesTeamWith(user) && user.role === 'member';
    }
    return false;
  };

  render() {
    const { users, teams, isLoading, error, newUserEmail, newUserRole, newUserTeam, isCreatingTeamAdmin } = this.state;
    const { userRole, userTeam } = this.props;
    const availableInviteRoles = this.getAvailableRolesForInvite();

    if (isLoading) {
      return <p>Loading users...</p>;
    }

    if (error) {
      return <p>Error loading users: {error.message}</p>;
    }

    return (
      <div>
        <h2>User Management</h2>
        <div className="table-responsive">
          <table className="table table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Team</th>
                {(userRole === 'admin' || userRole === 'team_admin' || userRole === 'team_leader') && <th>Invited By</th>}
                <th>OAuth Provider</th>
                <th>Created At</th>
              </tr>
            </thead>
            <tbody>
              {users.map((user) => {
                const canEdit = this.canEditUser(user);
                const editableRoles = this.getAvailableRolesForEdit(user);
                return (
                  <tr key={user.id}>
                    <td>{user.id}</td>
                    <td>{user.username}</td>
                    <td>{user.email}</td>
                    <td>
                      {((userRole === 'team_admin' || userRole === 'team_leader') && String(user.id) == String(this.props.currentUserId)) ? (
                        <span className="badge badge-info">{user.role.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                      ) : canEdit ? (
                        <select
                          className="form-control form-control-sm"
                          value={user.role}
                          onChange={(e) => this.handleRoleChange(user.id, e.target.value)}
                        >
                          {editableRoles.map(role => (
                            <option key={role.value} value={role.value}>{role.label}</option>
                          ))}
                        </select>
                      ) : (
                        <span className="badge badge-info">{user.role.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                      )}
                    </td>

                    {userRole === 'admin' ? (
                      <td>
                        <select
                          className="form-control form-control-sm"
                          value={user.team || 'none'}
                          onChange={(e) => this.handleTeamChange(user.id, e.target.value)}
                        >
                          <option value="none">None</option>
                          {teams.map(team => (
                            <option key={team} value={team}>{team}</option>
                          ))}
                        </select>
                      </td>
                    ) : (
                      <td><span className="badge badge-secondary">{user.team || 'none'}</span></td>
                    )}
                    {(userRole === 'admin' || userRole === 'team_admin' || userRole === 'team_leader') && (
                      <td>
                        {user.invitedBy ? (
                          <small>{user.invitedBy.username}</small>
                        ) : (
                          <small className="text-muted">N/A</small>
                        )}
                      </td>
                    )}
                    <td>{user.oauthProvider}</td>
                    <td><small>{new Date(user.createdAt).toLocaleDateString()}</small></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <hr/>

        <h3>Invite New User</h3>
        <form
          className="form-inviteuser"
          onSubmit={(e) => {
            e.preventDefault();
            this.handleInviteUser();
          }}
        >
          <div className="form-row">
            <div className="form-group col-md-6">
              <label>Email:</label>
              <input
                type="email"
                className="form-control"
                value={newUserEmail}
                onChange={(e) => this.setState({ newUserEmail: e.target.value })}
                required
              />
            </div>
            <div className="form-group col-md-3">
              <label>Role:</label>
              <select
                className="form-control"
                value={newUserRole}
                onChange={(e) => {
                  const role = e.target.value;
                  this.setState({ 
                    newUserRole: role,
                    isCreatingTeamAdmin: role === 'team_admin',
                    newUserTeam: (role === 'team_admin') ? '' : 'none'
                  });
                }}
                required
              >
                {availableInviteRoles.map(role => (
                  <option key={role.value} value={role.value}>{role.label}</option>
                ))}
              </select>
            </div>
            
            {userRole === 'admin' && newUserRole === 'team_admin' && (
              <div className="form-group col-md-3">
                <label>New Team Name:</label>
                <input
                  type="text"
                  className="form-control"
                  value={newUserTeam}
                  onChange={(e) => this.setState({ newUserTeam: e.target.value })}
                  placeholder="Enter new team name"
                  required
                />
              </div>
            )}
            
            {userRole === 'admin' && (newUserRole === 'team_leader' || newUserRole === 'member' || newUserRole === 'testing') && (
              <div className="form-group col-md-3">
                <label>Team:</label>
                <select
                  className="form-control"
                  value={newUserTeam}
                  onChange={(e) => this.setState({ newUserTeam: e.target.value })}
                >
                  <option value="none">None</option>
                  {teams.map(team => (
                    <option key={team} value={team}>{team}</option>
                  ))}
                </select>
              </div>
            )}
          </div>
          
          <button type="submit" className="btn btn-primary">
            Invite User
          </button>
          
          {userRole === 'admin' && newUserRole === 'team_admin' && (
            <p className="text-info mt-2">
              <small>
                <i className="fas fa-info-circle"></i> Creating a Team Admin will create a new team. 
                There can only be one Team Admin per team.
              </small>
            </p>
          )}
          
          {userRole === 'team_admin' && (
            <p className="text-muted mt-2">
              <small>New users will be added to your team: <strong>{userTeam}</strong></small>
            </p>
          )}
        </form>
      </div>
    );
  }
}