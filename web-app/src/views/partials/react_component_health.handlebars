// System Health Monitor Component
class SystemHealth extends React.Component {
    constructor(props) {
        super(props);
        this.state = {
            healthData: null,
            isLoading: true,
            error: null,
            lastUpdated: null,
            // Live host and per-instance telemetry, pushed rather than polled.
            liveStats: null,
            // Keyed by docker id so two desktops cannot share a busy state.
            killing: {},
            killError: null
        };
    }

    formatBytes = (bytes) => {
        if (bytes === null || bytes === undefined) return 'unknown';
        const gb = bytes / (1024 ** 3);
        return gb >= 1 ? gb.toFixed(1) + ' GB' : (bytes / (1024 ** 2)).toFixed(0) + ' MB';
    };

    // Green below two thirds, amber past that, red past ninety.
    meterState = (percent) => {
        if (percent === null || percent === undefined) return '';
        if (percent >= 90) return ' is-critical';
        if (percent >= 66) return ' is-warning';
        return '';
    };

    renderMeter = (label, percent, detail) => (
        <div className="stat-meter" key={label}>
            <div className="stat-meter-head">
                <span className="stat-meter-label">{label}</span>
                <span className="stat-meter-value">
                    {percent === null || percent === undefined ? 'unknown' : percent + '%'}
                </span>
            </div>
            <div className="stat-meter-track">
                <div
                    className={'stat-meter-fill' + this.meterState(percent)}
                    {{!-- The brace is escaped because handlebars owns {{ and JSX's
                         inline style object opens with the same two characters;
                         unescaped it is parsed as an expression and the page
                         500s at render. --}}
                    style=\{{ width: Math.min(100, Math.max(0, percent || 0)) + '%' }}
                />
            </div>
            {detail && <div className="stat-meter-detail">{detail}</div>}
        </div>
    );

    componentDidMount() {
        this.fetchHealthData();
        // The component health block still comes from its own endpoint; only
        // the live figures move to the stream, which pushes them every few
        // seconds without a request per panel.
        this.interval = setInterval(() => {
            this.fetchHealthData();
        }, 30000);

        this.unsubscribeStats = dashboardFeed.on('stats', (liveStats) => {
            this.setState({ liveStats });
        });
    }

    /**
     * Stop one desktop from here.
     *
     * The confirmation names the person rather than the container, because the
     * decision being made is "cut this person off", and viper-cloud-xpi04 does
     * not read like a decision about anybody.
     */
    killInstance = (instance) => {
        const who = instance.owner ? instance.owner.displayName + ' (' + instance.owner.email + ')' : instance.name;

        if (!window.confirm(
            'Stop the desktop belonging to ' + who + '?\n\n' +
            'Anything unsaved in it is lost. They can start a replacement from their own page straight away.'
        )) return;

        this.setState(prev => ({
            killing: Object.assign({}, prev.killing, { [instance.dockerId]: true }),
            killError: null
        }));

        const done = () => this.setState(prev => {
            const killing = Object.assign({}, prev.killing);
            delete killing[instance.dockerId];
            return { killing };
        });

        fetchJson('/service/terminate-instance/' + instance.dockerId, { method: 'POST' })
            // No refetch: the stats stream drops it from the next tick by
            // itself, which is also how it disappears when someone else acts.
            .then(done)
            .catch(error => {
                this.setState({ killError: error.message });
                done();
            });
    };

    componentWillUnmount() {
        if (this.interval) {
            clearInterval(this.interval);
        }
        if (this.unsubscribeStats) this.unsubscribeStats();
    }

    componentDidUpdate() {
        // Set colors for elements with data-color attributes
        const colorElements = document.querySelectorAll('[data-color]');
        colorElements.forEach(element => {
            const color = element.getAttribute('data-color');
            if (color) {
                element.style.color = color;
            }
        });
    }

    fetchHealthData = async () => {
        try {
            const response = await fetch('/service/health');
            const data = await response.json();
            
            this.setState({
                healthData: data,
                isLoading: false,
                error: null,
                lastUpdated: new Date()
            });
        } catch (error) {
            this.setState({
                error: error.message,
                isLoading: false
            });
        }
    }

    getStatusIcon = (status) => {
        switch (status) {
            case 'healthy':
                return { icon: 'fas fa-check-circle', color: '#28a745' };
            case 'degraded':
                return { icon: 'fas fa-exclamation-triangle', color: '#ffc107' };
            case 'error':
                return { icon: 'fas fa-times-circle', color: '#dc3545' };
            default:
                return { icon: 'fas fa-question-circle', color: '#6c757d' };
        }
    }

    formatUptime = (seconds) => {
        const days = Math.floor(seconds / 86400);
        const hours = Math.floor((seconds % 86400) / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        
        if (days > 0) {
            return `${days}d ${hours}h ${minutes}m`;
        } else if (hours > 0) {
            return `${hours}h ${minutes}m`;
        } else {
            return `${minutes}m`;
        }
    }

    formatMemory = (bytes) => {
        const mb = bytes / 1024 / 1024;
        return `${mb.toFixed(1)} MB`;
    }

    render() {
        const { healthData, isLoading, error, lastUpdated, liveStats, killing, killError } = this.state;

        if (isLoading) {
            return (
                <div className="loading">
                    <i className="fas fa-spinner fa-spin"></i>
                    <p>Loading system health data...</p>
                </div>
            );
        }

        if (error) {
            return (
                <div className="alert alert-danger">
                    <h4><i className="fas fa-exclamation-triangle"></i> Error Loading Health Data</h4>
                    <p>{error}</p>
                    <button className="btn btn-outline-danger" onClick={this.fetchHealthData}>
                        <i className="fas fa-redo"></i> Retry
                    </button>
                </div>
            );
        }

        if (!healthData) {
            return <div className="alert alert-warning">No health data available</div>;
        }

        const statusInfo = this.getStatusIcon(healthData.status);

        const host = liveStats && liveStats.host;

        return (
            <div className="health-monitor">
                {host && (
                    <div className="server-load">
                        <h4 className="server-load-title">
                            <i className="fas fa-server"></i> Server load
                            <span className="server-load-live">live</span>
                        </h4>

                        <div className="server-load-meters">
                            {this.renderMeter(
                                'CPU load',
                                host.loadPercent,
                                host.loadAverage && host.loadAverage.length
                                    ? 'load ' + host.loadAverage.join(', ') + ' across ' + host.cpuCount + ' cores'
                                    : null
                            )}

                            {host.memory && this.renderMeter(
                                'Memory',
                                host.memory.usedPercent,
                                this.formatBytes(host.memory.usedBytes) + ' of ' +
                                this.formatBytes(host.memory.totalBytes) + ' used, ' +
                                this.formatBytes(host.memory.availableBytes) + ' available'
                            )}

                            {host.disk && this.renderMeter(
                                'Disk',
                                host.disk.usedPercent,
                                this.formatBytes(host.disk.freeBytes) + ' free of ' +
                                this.formatBytes(host.disk.totalBytes) +
                                '. A ViPER image is around 10 GB.'
                            )}
                        </div>

                        {host.containers && (
                            <p className="server-load-containers">
                                {host.containers.running} of {host.containers.total} containers running
                            </p>
                        )}

                        <h5 className="server-load-subtitle">Desktops</h5>
                        {killError && <div className="image-warning">{killError}</div>}
                        {liveStats.instances.length === 0 ? (
                            <p className="text-muted">No desktops are running.</p>
                        ) : (
                            <table className="table table-sm instance-load-table">
                                <thead>
                                    <tr><th>Instance</th><th>Owner</th><th>CPU</th><th>Memory</th><th></th></tr>
                                </thead>
                                <tbody>
                                    {liveStats.instances.map(instance => (
                                        <tr key={instance.name}>
                                            <td className="instance-load-name">{instance.name}</td>
                                            <td>
                                                {instance.owner ? (
                                                    <span>
                                                        {instance.owner.displayName}
                                                        <span className="instance-load-email">{instance.owner.email}</span>
                                                    </span>
                                                ) : (
                                                    <span className="text-muted">unknown</span>
                                                )}
                                            </td>
                                            <td>{instance.cpuPercent === null ? '-' : instance.cpuPercent + '%'}</td>
                                            <td>{this.formatBytes(instance.memoryBytes)}</td>
                                            <td>
                                                <button type="button"
                                                    className="btn btn-sm btn-outline-danger"
                                                    disabled={killing[instance.dockerId]}
                                                    onClick={() => this.killInstance(instance)}>
                                                    {killing[instance.dockerId] ? 'Stopping...' : 'Kill'}
                                                </button>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        )}
                    </div>
                )}

                <div className="health-header">
                    <div className="health-status">
                        <i className={statusInfo.icon + ' health-status-icon'} 
                           data-color={statusInfo.color}></i>
                        <div className="status-info">
                            <h3 className="system-status-title" data-color={statusInfo.color}>
                                System {healthData.status}
                            </h3>
                            <p className="text-muted">
                                Last updated: {lastUpdated ? lastUpdated.toLocaleString() : 'Unknown'}
                            </p>
                        </div>
                    </div>
                    <button className="btn btn-outline-primary" onClick={this.fetchHealthData}>
                        <i className="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>

                <div className="health-cards">
                    {/* System Info Card */}
                    <div className="health-card">
                        <div className="card-header">
                            <h4><i className="fas fa-server"></i> System Information</h4>
                        </div>
                        <div className="card-body">
                            <div className="health-metric">
                                <span className="metric-label">Environment:</span>
                                <span className="metric-value">{healthData.environment}</span>
                            </div>
                            <div className="health-metric">
                                <span className="metric-label">Uptime:</span>
                                <span className="metric-value">{this.formatUptime(healthData.uptime)}</span>
                            </div>
                            <div className="health-metric">
                                <span className="metric-label">Timestamp:</span>
                                <span className="metric-value">
                                    {new Date(healthData.timestamp).toLocaleString()}
                                </span>
                            </div>
                        </div>
                    </div>

                    {/* Database Card */}
                    <div className="health-card">
                        <div className="card-header">
                            <h4>
                                <i className="fas fa-database"></i> Database
                                <span className={`status-badge ${healthData.database && healthData.database.status === 'connected' ? 'status-active' : 'status-error'}`}>
                                    {(healthData.database && healthData.database.status) || 'unknown'}
                                </span>
                            </h4>
                        </div>
                        <div className="card-body">
                            {healthData.database && healthData.database.status === 'connected' ? (
                                <div className="success-message">
                                    <i className="fas fa-check-circle text-success"></i>
                                    Database connection is healthy
                                </div>
                            ) : (
                                <div className="error-message">
                                    <i className="fas fa-times-circle text-danger"></i>
                                    {(healthData.database && healthData.database.message) || 'Database connection failed'}
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Docker Card */}
                    <div className="health-card">
                        <div className="card-header">
                            <h4>
                                <i className="fab fa-docker"></i> Docker
                                <span className={`status-badge ${healthData.docker && healthData.docker.status === 'connected' ? 'status-active' : 'status-error'}`}>
                                    {(healthData.docker && healthData.docker.status) || 'unknown'}
                                </span>
                            </h4>
                        </div>
                        <div className="card-body">
                            {healthData.docker && healthData.docker.status === 'connected' ? (
                                <div className="success-message">
                                    <i className="fas fa-check-circle text-success"></i>
                                    Docker daemon is accessible
                                </div>
                            ) : (
                                <div className="error-message">
                                    <i className="fas fa-times-circle text-danger"></i>
                                    {(healthData.docker && healthData.docker.message) || 'Docker connection failed'}
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Statistics Card (Admin only) */}
                    {healthData.statistics && (
                        <div className="health-card statistics-card">
                            <div className="card-header">
                                <h4><i className="fas fa-chart-bar"></i> System Statistics</h4>
                            </div>
                            <div className="card-body">
                                <div className="stats-grid">
                                    <div className="stat-item">
                                        <div className="stat-number">{healthData.statistics.totalInstances}</div>
                                        <div className="stat-label">Total Instances</div>
                                    </div>
                                    <div className="stat-item">
                                        <div className="stat-number">{healthData.statistics.activeInstances}</div>
                                        <div className="stat-label">Active Instances</div>
                                    </div>
                                    <div className="stat-item">
                                        <div className="stat-number">{healthData.statistics.totalUsers}</div>
                                        <div className="stat-label">Total Users</div>
                                    </div>
                                </div>
                                
                                {healthData.statistics.memoryUsage && (
                                    <div className="memory-usage">
                                        <h5>Memory Usage</h5>
                                        <div className="memory-stats">
                                            <div className="memory-stat">
                                                <span>RSS:</span>
                                                <span>{this.formatMemory(healthData.statistics.memoryUsage.rss)}</span>
                                            </div>
                                            <div className="memory-stat">
                                                <span>Heap Used:</span>
                                                <span>{this.formatMemory(healthData.statistics.memoryUsage.heapUsed)}</span>
                                            </div>
                                            <div className="memory-stat">
                                                <span>Heap Total:</span>
                                                <span>{this.formatMemory(healthData.statistics.memoryUsage.heapTotal)}</span>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        );
    }
}
