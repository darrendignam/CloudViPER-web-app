      }
      
      .screenshot-badge {
        background: rgba(40,167,69,0.8);
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 9px;
      }
      
      /* Screenshot Modal Styles */
      .screenshot-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
      }
      
      .screenshot-modal-content {
        position: relative;
        max-width: 95vw;
        max-height: 95vh;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      }
      
      .screenshot-modal-header {
        padding: 15px 20px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .modal-title {
        margin: 0;
        font-size: 16px;
      }
      
      .screenshot-modal-body {
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        max-height: calc(95vh - 80px);
      }
      
      .screenshot-modal-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
      
      .screenshot-modal-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #6c757d;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
