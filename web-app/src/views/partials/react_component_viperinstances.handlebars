    /* Activity Chart Styles */
    const chartStyles = `
      .activity-chart-container {
        text-align: center;
        padding: 10px;
        background: #eaf6fb;
        border-radius: 8px;
        margin: 5px;
      }
      .chart-title {
        color: #495057;
        margin-bottom: 8px;
        font-weight: 600;
      }
      .chart-legend {
        display: flex;
        justify-content: space-around;
        margin-top: 5px;
      }
      .instance-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: center;
      }
      .instance-buttons .btn {
        margin: 2px;
      }
      .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
        padding: 10px;
      }
      
      /* Screenshot Carousel Styles */
      .screenshot-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .screenshot-container.loading {
        background: #f8f9fa;
      }
      
      .loading-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 5px;
        font-size: 10px;
        text-align: center;
      }
      
      .carousel-container {
        border: 2px solid #dee2e6;
        transition: border-color 0.3s ease;
      }
      
      .carousel-container:hover {
        border-color: #007bff;
      }
      
      .screenshot-wrapper {
        position: relative;
        width: 100%;
      }
      
      .screenshot-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        cursor: pointer;
      }
      
      .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.7);
        color: white;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 10;
      }
      
      .carousel-btn:hover {
        background: rgba(0,0,0,0.9);
        transform: translateY(-50%) scale(1.1);
      }
      
      .carousel-prev {
        left: 5px;
      }
      
      .carousel-next {
        right: 5px;
      }
      
      .screenshot-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        color: white;
        padding: 8px 5px 5px 5px;
        font-size: 10px;
        display: flex;
        justify-content: space-between;
        align-items: end;
      }
      
      .screenshot-counter {
        background: rgba(255,255,255,0.2);
        padding: 2px 6px;
        border-radius: 10px;
        font-weight: bold;
      }
      
      .screenshot-badge {
        background: rgba(40,167,69,0.8);
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 9px;
      }
      
      /* Screenshot Modal Styles */
      .screenshot-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
      }
      
      .screenshot-modal-content {
        position: relative;
        max-width: 95vw;
        max-height: 95vh;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      }
      
      .screenshot-modal-header {
        padding: 15px 20px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .modal-title {
        margin: 0;
        font-size: 16px;
      }
      
      .screenshot-modal-body {
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        max-height: calc(95vh - 80px);
      }
      
      .screenshot-modal-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
      
      .screenshot-modal-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #6c757d;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .screenshot-modal-close:hover {
        color: #000;
      }
    `;
    
    // Inject styles
    if (!document.getElementById('activity-chart-styles')) {
      const styleSheet = document.createElement('style');
      styleSheet.id = 'activity-chart-styles';
      styleSheet.textContent = chartStyles;
      document.head.appendChild(styleSheet);
    }

    class ViPERInstanceList extends React.Component {
      constructor(props) {
        super(props);
        this.state = {
          instances: [],
          isLoading: true,
          error: null,
          selectedInstance: null,
          instanceDetails: null,
          detailsLoading: false,
          // Filter state
          filters: {
            active: true,
            inactive: true,
            building: true,
            created: true,
            // Off by default. A terminated instance is a historical record, not
            // something anyone is managing, and rows grow without bound as the
            // appliance is used.
            deleted: false,
            error: true,
            pending: true
          },
          showFilters: false,
          // Image selection. Only some roles may choose, and the server refuses
          // the rest, so the control only appears for those who can use it.
          launchableImages: [],
          // The advanced launch panel. Admin only, and closed until asked for:
          // the ordinary case is one button, and it should stay that way.
          advancedOpen: false,
          launchOwnerId: '',
          candidateOwners: [],
          launchEnv: [],
          launchVolumes: [],
          launchShares: [],
          advancedPrimed: false,
          selectedImageId: '',
          buildMode: false,
          launchError: null,
          // Which buttons are mid-request. Without this a click looks like
          // nothing happened, so people click again, and two terminations of
          // the same instance race each other.
          starting: false,
          removing: {},
          // Saving a build instance as an image
          saveTarget: null,
          saveName: '',
          saveTag: 'latest',
          saveDescription: '',
          savePromote: true,
          saving: false,
          saveError: null,
          // Screenshot carousel state
          screenshotCarousels: {}, // Store carousel data for each instance
          // Screenshot modal state
          screenshotModal: {
            isOpen: false,
            imageUrl: '',
            instanceUUID: '',
            screenshotIndex: 0,
            title: ''
          }
        };
      }

      componentDidMount() {
        // The stream pushes the first list immediately on connect, so there is
        // no separate initial fetch; a request here would only duplicate it.
        this.unsubscribe = dashboardFeed.on('instances', (instances) => {
          this.setState({ instances, isLoading: false, error: null });
        });
        this.unsubscribeError = dashboardFeed.on('feed-error', (payload) => {
          this.setState({ error: payload.message, isLoading: false });
        });

        if (this.canChooseImage()) {
          this.fetchLaunchableImages();
        }
      }

      // Mirrors ROLES_THAT_MAY_CHOOSE on the server. Everyone else silently
      // gets their team's default, which is the point of having a default.
      canChooseImage = () => {
        return ['admin', 'team_admin', 'team_leader'].indexOf(this.props.userRole) !== -1;
      };

      openSaveAsImage = (instance) => {
        this.setState({
          saveTarget: instance,
          saveName: '',
          saveTag: 'latest',
          saveDescription: '',
          savePromote: true,
          saveError: null
        });
      };

      closeSaveAsImage = () => this.setState({ saveTarget: null, saveError: null });

      submitSaveAsImage = () => {
        const { saveTarget, saveName, saveTag, saveDescription, savePromote } = this.state;
        if (!saveName.trim()) {
          this.setState({ saveError: 'A name is required' });
          return;
        }

        this.setState({ saving: true, saveError: null });

        fetchJson('/images/api/commit/' + encodeURIComponent(saveTarget.uuid), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: saveName.trim(),
            tag: saveTag.trim() || 'latest',
            description: saveDescription,
            promoteDesktop: savePromote
          })
        })
          .then(() => {
            this.setState({ saving: false, saveTarget: null });
            this.fetchInstances();
            if (this.canChooseImage()) this.fetchLaunchableImages();
          })
          .catch(error => this.setState({ saving: false, saveError: error.message }));
      };

      /**
       * Fill the advanced panel from whatever this launch would do untouched,
       * so an admin edits a real configuration rather than an empty form and
       * has to remember what the image already sets.
       */
      openAdvanced = () => {
        if (this.state.advancedOpen) {
          this.setState({ advancedOpen: false });
          return;
        }

        this.setState({ advancedOpen: true });

        if (this.state.advancedPrimed) return;

        var chosen = this.state.launchableImages.find(
          image => String(image.id) === String(this.state.selectedImageId));

        if (!chosen) {
          chosen = this.state.launchableImages.find(image => image.isGlobalDefault);
        }

        this.setState({
          advancedPrimed: true,
          launchEnv: chosen ? Object.entries(chosen.envVars || {}).map(([name, value]) => ({ name, value })) : [],
          launchVolumes: chosen ? (chosen.volumes || []).map(v => Object.assign({}, v)) : []
        });

        fetchJson('/account/users')
          .then(payload => this.setState({
            candidateOwners: (payload.users || payload || []).map(u => ({
              id: u.id, username: u.username, email: u.email, role: u.role
            }))
          }))
          .catch(() => { /* The owner picker degrades to "me", which is the default anyway. */ });

        fetchJson('/images/api/shares')
          .then(payload => this.setState({ launchShares: payload.directories || [] }))
          .catch(() => { /* Mount editing degrades to what the image already set. */ });
      };

      updateLaunchEnv = (index, field, value) => {
        this.setState(prev => ({
          launchEnv: prev.launchEnv.map((entry, i) =>
            i === index ? Object.assign({}, entry, { [field]: value }) : entry)
        }));
      };

      updateLaunchVolume = (index, field, value) => {
        this.setState(prev => ({
          volumesEdited: true,
          launchVolumes: prev.launchVolumes.map((mount, i) =>
            i === index ? Object.assign({}, mount, { [field]: value }) : mount)
        }));
      };

      fetchLaunchableImages = () => {
        fetchJson('/images/api/launchable')
          .then(images => this.setState({ launchableImages: images }))
          .catch(error => console.error('Could not load launchable images:', error));
      };

      componentWillUnmount() {
        if (this.unsubscribe) this.unsubscribe();
        if (this.unsubscribeError) this.unsubscribeError();
      }

      fetchInstances = () => {
        fetchJson('/service/viperinstances')
          .then(data => {
            // Handle the new API response format
            let instances = [];
            if (data && Array.isArray(data.instances)) {
              instances = data.instances;
            } else if (Array.isArray(data)) {
              // Fallback for old format
              instances = data;
            }
            console.log('Fetched instances:', instances); // Debug log
            this.setState({ instances: instances, isLoading: false }, () => {
              // Refresh charts and initialize screenshot carousels after state update
              this.refreshAllCharts();
              this.initializeAllScreenshotCarousels();
            });
          })
          .catch(error => {
            console.error('Error fetching instances:', error);
            this.setState({ error, isLoading: false, instances: [] });
          });
      }

      // Initialize screenshot carousels for all instances
      initializeAllScreenshotCarousels = () => {
        const { instances } = this.state;
        instances.forEach(instance => {
          // Small delay to ensure DOM is ready
          setTimeout(() => this.initializeScreenshotCarousel(instance.uuid), 300);
        });
      }

      // Refresh all activity charts
      refreshAllCharts = () => {
        const { instances } = this.state;
        instances.forEach(instance => {
          const canvasId = `chart-${instance.uuid}`;
          // Small delay to ensure DOM is updated
          setTimeout(() => this.initializeChart(canvasId, instance.uuid), 200);
        });
      }

      // Screenshot carousel methods
      fetchScreenshotsForInstance = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/screenshots/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success) {
            return {
              uniqueScreenshots: data.uniqueScreenshots || [],
              totalCount: data.totalScreenshots || 0,
              uniqueCount: data.uniqueCount || 0
            };
          }
          return { uniqueScreenshots: [], totalCount: 0, uniqueCount: 0 };
        } catch (error) {
          console.error('Error fetching screenshots:', error);
          return { uniqueScreenshots: [], totalCount: 0, uniqueCount: 0 };
        }
      }

      // Initialize screenshot carousel for an instance
      initializeScreenshotCarousel = async (instanceUUID) => {
        const screenshotData = await this.fetchScreenshotsForInstance(instanceUUID);
        
        this.setState(prevState => ({
          screenshotCarousels: {
            ...prevState.screenshotCarousels,
            [instanceUUID]: {
              screenshots: screenshotData.uniqueScreenshots,
              currentIndex: 0,
              totalCount: screenshotData.totalCount,
              uniqueCount: screenshotData.uniqueCount,
              hasScreenshots: screenshotData.uniqueScreenshots.length > 0
            }
          }
        }));
      }

      // Navigate carousel
      navigateScreenshot = (instanceUUID, direction) => {
        this.setState(prevState => {
          const carousel = prevState.screenshotCarousels[instanceUUID];
          if (!carousel || carousel.screenshots.length === 0) return prevState;

          let newIndex = carousel.currentIndex;
          if (direction === 'next') {
            newIndex = (newIndex + 1) % carousel.screenshots.length;
          } else if (direction === 'prev') {
            newIndex = newIndex === 0 ? carousel.screenshots.length - 1 : newIndex - 1;
          }

          return {
            screenshotCarousels: {
              ...prevState.screenshotCarousels,
              [instanceUUID]: {
                ...carousel,
                currentIndex: newIndex
              }
            }
          };
        });
      }

      // Screenshot modal methods
      openScreenshotModal = (instance, currentScreenshot) => {
        const screenshotSrc = `/service/screenshot-image/${instance.uuid}?index=${currentScreenshot && currentScreenshot.index ? currentScreenshot.index : 0}`;
        const title = `${instance.name} - Screenshot ${currentScreenshot && currentScreenshot.capturedAt ? new Date(currentScreenshot.capturedAt).toLocaleString() : 'Unknown'}`;
        
        this.setState({
          screenshotModal: {
            isOpen: true,
            imageUrl: screenshotSrc,
            instanceUUID: instance.uuid,
            screenshotIndex: currentScreenshot ? currentScreenshot.index : 0,
            title: title
          }
        });
      }

      closeScreenshotModal = () => {
        this.setState({
          screenshotModal: {
            isOpen: false,
            imageUrl: '',
            instanceUUID: '',
            screenshotIndex: 0,
            title: ''
          }
        });
      }

      startNewInstance = () => {
        const { selectedImageId, buildMode, starting, advancedOpen,
                launchOwnerId, launchEnv, launchVolumes } = this.state;
        if (starting) return;
        const body = {};

        // Left blank means "whatever the default is", which is a different
        // request from naming an image, so it is omitted rather than sent empty.
        if (selectedImageId) body.imageId = Number(selectedImageId);
        if (buildMode) body.buildMode = true;

        // Only sent when the panel is open. A closed panel must mean "launch it
        // the way the image says", not "launch it with whatever was left in
        // these fields last time".
        if (advancedOpen && this.props.userRole === 'admin') {
          if (launchOwnerId) body.ownerId = Number(launchOwnerId);

          var env = {};
          var named = false;
          launchEnv.forEach(function (entry) {
            if (entry.name.trim()) { env[entry.name.trim()] = entry.value; named = true; }
          });
          if (named) body.envOverrides = env;

          // Omitted unless edited, because an empty list is a real instruction
          // here: it means mount nothing.
          if (this.state.volumesEdited) body.volumeOverrides = launchVolumes;
        }

        this.setState({ launchError: null, starting: true });

        fetchJson('/service/new-instance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        })
          .then(() => {
            // The feed pushes the new list on its next tick, so there is no
            // fetch here; the button simply stops being busy.
            this.setState({
              buildMode: false,
              starting: false,
              advancedOpen: false,
              advancedPrimed: false,
              volumesEdited: false,
              launchOwnerId: '',
              launchEnv: [],
              launchVolumes: []
            });
          })
          .catch(error => this.setState({ launchError: error.message, starting: false }));
      }

      removeInstance = (dockerid) => {
        // Ignore a second click on an instance already being removed. Two
        // concurrent terminations of the same container race, and the loser is
        // told it failed about a container that was in fact removed.
        if (this.state.removing[dockerid]) return;

        this.setState(prev => ({
          removing: Object.assign({}, prev.removing, { [dockerid]: true }),
          launchError: null
        }));

        const done = () => this.setState(prev => {
          const removing = Object.assign({}, prev.removing);
          delete removing[dockerid];
          return { removing };
        });

        fetchJson('/service/terminate-instance/' + dockerid, { method: 'POST' })
          .then(() => {
            // Drop it immediately so the row does not linger while waiting for
            // the next push; the feed will confirm it shortly.
            this.setState(prev => ({
              instances: prev.instances.filter(instance => instance.dockerid !== dockerid)
            }));
            done();
          })
          .catch(error => {
            // The row is marked deleted even when the container survives, so
            // the message matters rather than being swallowed to the console.
            this.setState({ launchError: error.message });
            done();
          });
      }

      formatOwnerInfo = (instance) => {
        if (!instance) {
          return 'Unknown';
        }
        
        if (instance.ownerUser) {
          const user = instance.ownerUser;
          // Prefer firstName + lastName, then username, then email
          if (user.firstName && user.lastName) {
            return `${user.firstName} ${user.lastName} (${user.email})`;
          } else if (user.username) {
            return `${user.username} (${user.email})`;
          } else {
            return user.email;
          }
        }
        // Fallback to owner ID if user data is not available
        return 'User ID: ' + (instance.owner || 'Unknown');
      }

      showInstanceDetails = async (instance) => {
        this.setState({ detailsLoading: true, selectedInstance: instance });
        
        try {
          const response = await fetch(`/service/viperinstance/${instance.dockerid}/inspect`);
          if (response.ok) {
            const details = await response.json();
            this.setState({ instanceDetails: details, detailsLoading: false });
          } else {
            console.error('Failed to fetch instance details');
            this.setState({ 
              instanceDetails: { 
                error: 'Failed to fetch details',
                instance: instance,
                operationalHours: 'Unknown',
                dockerInspect: { error: 'API request failed', message: 'Could not fetch Docker details' }
              }, 
              detailsLoading: false 
            });
          }
        } catch (error) {
          console.error('Error fetching instance details:', error);
          this.setState({ 
            instanceDetails: { 
              error: 'Error fetching details',
              instance: instance,
              operationalHours: 'Unknown',
              dockerInspect: { error: 'Network error', message: error.message || 'Unknown error occurred' }
            }, 
            detailsLoading: false 
          });
        }
      }

      closeDetailsPanel = () => {
        this.setState({ selectedInstance: null, instanceDetails: null });
      }

      formatBytes = (bytes) => {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
      }

      isAdmin = () => {
        // Check if current user is admin - we'll get this from props
        return this.props.userRole === 'admin';
      }

      // Filter methods
      toggleFilter = (status) => {
        this.setState(prevState => ({
          filters: {
            ...prevState.filters,
            [status]: !prevState.filters[status]
          }
        }));
      }

      toggleFiltersPanel = () => {
        this.setState(prevState => ({
          showFilters: !prevState.showFilters
        }));
      }

      getFilteredInstances = () => {
        const { instances, filters } = this.state;
        if (!Array.isArray(instances)) return [];
        
        return instances.filter(instance => {
          const status = instance.status || 'unknown';
          return filters[status] !== false;
        });
      }

      selectAllFilters = () => {
        this.setState({
          filters: {
            active: true,
            inactive: true,
            building: true,
            created: true,
            deleted: true,
            error: true,
            pending: true
          }
        });
      }

      clearAllFilters = () => {
        this.setState({
          filters: {
            active: false,
            inactive: false,
            building: false,
            created: false,
            deleted: false,
            error: false,
            pending: false
          }
        });
      }

      launchUrl = (uuid) => {
        return '/service/launch/' + uuid;
      }

      loadActivityHistory = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/activity/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success) {
            // Enhanced display with better formatting and null checking
            const avgCpu = data.summary.avgCpuUsage != null ? Number(data.summary.avgCpuUsage).toFixed(1) : 'N/A';
            const avgMemory = data.summary.avgMemoryUsage != null ? Number(data.summary.avgMemoryUsage).toFixed(1) : 'N/A';
            
            alert(`Activity Summary for ${instanceUUID}:
Total Events: ${data.summary.totalEvents || 0}
Average CPU Usage: ${avgCpu}%
Average Memory Usage: ${avgMemory}%
Last Activity: ${data.summary.lastActivity ? new Date(data.summary.lastActivity).toLocaleString() : 'Never'}
User Currently Active: ${data.summary.isUserActive ? 'Yes' : 'No'}
Current Activity Score: ${data.summary.currentScore || 0}`);
          } else {
            console.error('Error loading activity:', data.error);
            alert('Error loading activity history: ' + data.error);
          }
        } catch (error) {
          console.error('Error fetching activity:', error);
          alert('Error fetching activity history: ' + error.message);
        }
      }

      // Fetch activity data for charts (last 30 points)
      fetchActivityDataForChart = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/activity/${instanceUUID}?limit=30`);
          const data = await response.json();
          
          if (data.success && data.activityHistory) {
            return data.activityHistory.reverse(); // Reverse to show chronological order
          }
          return [];
        } catch (error) {
          console.error('Error fetching chart data:', error);
          return [];
        }
      }

      // Component for screenshot carousel
      renderScreenshotCarousel = (instance) => {
        const { screenshotCarousels } = this.state;
        const carousel = screenshotCarousels[instance.uuid];
        
        // Initialize carousel if not already done
        if (!carousel) {
          setTimeout(() => this.initializeScreenshotCarousel(instance.uuid), 100);
          return React.createElement('div', { className: 'screenshot-container loading' },
            React.createElement('img', { 
              src: '/images/CloudViPER-Logo.png',
              className: 'card-img-custom',
              alt: 'Loading...',
              style: { opacity: 0.7 }
            }),
            React.createElement('div', { className: 'loading-overlay' }, 'Loading screenshots...')
          );
        }

        // If no screenshots available, show default logo
        if (!carousel.hasScreenshots) {
          return React.createElement('div', { className: 'screenshot-container' },
            React.createElement('img', { 
              src: '/images/CloudViPER-Logo.png',
              className: 'card-img-custom',
              alt: 'ViPER Instance',
              title: 'No screenshots available'
            })
          );
        }

        // Show screenshot carousel
        const currentScreenshot = carousel.screenshots[carousel.currentIndex];
        const screenshotSrc = `/service/screenshot-image/${instance.uuid}?index=${currentScreenshot && currentScreenshot.index ? currentScreenshot.index : 0}`;
        
        return React.createElement('div', { className: 'screenshot-container carousel-container' },
          // Main screenshot image
