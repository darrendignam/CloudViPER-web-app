      initializeChart = async (canvasId, instanceUUID) => {
        const activityData = await this.fetchActivityDataForChart(instanceUUID);
        
        if (activityData.length === 0) {
          // Draw "No Data" message
          const canvas = document.getElementById(canvasId);
          if (!canvas) return;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#f8f9fa';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#6c757d';
          ctx.font = '12px Arial';
          ctx.textAlign = 'center';
          ctx.fillText('No Activity Data', canvas.width / 2, canvas.height / 2);
          return;
        }

        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        
        // Prepare data
        const cpuData = activityData.map(d => parseFloat(d.cpuUsage) || 0);
        const memoryData = activityData.map(d => parseFloat(d.memoryUsage) || 0);
        const activityScores = activityData.map(d => d.activityScore || 0);
        
        // Chart dimensions
        const width = canvas.width;
        const height = canvas.height;
        const padding = 15;
        const chartWidth = width - 2 * padding;
        const chartHeight = height - 2 * padding;
        
        // Clear canvas
        ctx.clearRect(0, 0, width, height);
        
        // Draw background
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, width, height);
        
        // Draw grid lines
        ctx.strokeStyle = '#f1f3f4';
        ctx.lineWidth = 0.5;
        for (let i = 1; i < 4; i++) {
          const y = padding + (i * chartHeight / 4);
          ctx.beginPath();
          ctx.moveTo(padding, y);
          ctx.lineTo(padding + chartWidth, y);
          ctx.stroke();
        }
        
        if (activityData.length > 1) {
          const maxCpu = Math.max(...cpuData, 20); // Minimum scale of 20%
          const maxMemory = Math.max(...memoryData, 20);
          const maxActivity = Math.max(...activityScores, 5); // Minimum scale of 5
          
          // Draw CPU line (red)
          ctx.strokeStyle = '#dc3545';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          cpuData.forEach((value, index) => {
            const x = padding + (index / (cpuData.length - 1)) * chartWidth;
            const y = padding + chartHeight - (value / maxCpu) * chartHeight;
            if (index === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
          });
          ctx.stroke();
          
          // Draw Memory line (blue)
          ctx.strokeStyle = '#007bff';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          memoryData.forEach((value, index) => {
            const x = padding + (index / (memoryData.length - 1)) * chartWidth;
            const y = padding + chartHeight - (value / maxMemory) * chartHeight;
            if (index === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
          });
          ctx.stroke();
          
          // Draw Activity dots (green) - only when activity > 0
          ctx.fillStyle = '#28a745';
          activityScores.forEach((value, index) => {
            if (value > 0) {
              const x = padding + (index / (activityScores.length - 1)) * chartWidth;
              const y = padding + chartHeight - (value / maxActivity) * chartHeight;
              ctx.beginPath();
              ctx.arc(x, y, 2, 0, 2 * Math.PI);
              ctx.fill();
            }
          });
        }
        
        // Draw border
        ctx.strokeStyle = '#dee2e6';
        ctx.lineWidth = 1;
        ctx.strokeRect(0, 0, width, height);
      }

      viewScreenshot = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/screenshot/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success && data.screenshot) {
            // Create a modal or new window to display the screenshot
            const screenshotWindow = window.open('', '_blank', 'width=800,height=600');
            screenshotWindow.document.write(`
              <html>
                <head><title>Screenshot - ${instanceUUID}</title></head>
                <body style="margin:0;padding:20px;background:#f0f0f0;">
                  <h3>Instance Screenshot</h3>
                  <p><strong>Instance:</strong> ${instanceUUID}</p>
                  <p><strong>Captured:</strong> ${data.screenshot.capturedAt ? new Date(data.screenshot.capturedAt).toLocaleString() : 'Unknown'}</p>
                  <img src="data:image/png;base64,${data.screenshot.screenshot}" style="max-width:100%;border:1px solid #ccc;" />
                </body>
              </html>
            `);
          } else {
            alert('No screenshot available for this instance');
          }
        } catch (error) {
          console.error('Error fetching screenshot:', error);
          alert('Error fetching screenshot');
        }
      }

      cleanupInactiveInstances = async () => {
        if (!confirm('This will automatically shutdown instances that have been inactive for 30+ minutes. Continue?')) {
          return;
        }

        try {
          const response = await fetch('/service/cleanup-inactive', { method: 'POST' });
          const data = await response.json();
          
          if (data.success) {
            alert(`Cleanup completed: ${data.shutdownCount} instances shut down`);
            this.fetchInstances(); // Refresh the list
          } else {
            alert('Error during cleanup: ' + data.error);
          }
        } catch (error) {
          console.error('Error during cleanup:', error);
          alert('Error during cleanup');
        }
      }

