class SessionList extends React.Component {
      constructor(props) {
        super(props);
        this.state = {
          sessions: [],
          isLoading: true,
          error: null,
          isRevoking: false,
          deletingSession: null
        };
      }

      componentDidMount() {
        this.loadSessions();
      }

      loadSessions = () => {
        this.setState({ isLoading: true, error: null });
        fetchJson('/account/sessions')
          .then(data => this.setState({ sessions: data, isLoading: false }))
          .catch(error => this.setState({ error, isLoading: false }));
      }

      revokeAllSessions = async () => {
        if (!confirm('Are you sure you want to revoke ALL sessions? This will log out all users immediately.')) {
          return;
        }

        this.setState({ isRevoking: true });
        
        try {
          const response = await fetch('/account/sessions', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          });
          
          const result = await response.json();
          
          if (result.success) {
            alert(`Success: ${result.message}`);
            this.loadSessions(); // Refresh the list
          } else {
            alert(`Error: ${result.message}`);
          }
        } catch (error) {
          alert(`Error revoking sessions: ${error.message}`);
        } finally {
          this.setState({ isRevoking: false });
        }
      }

      deleteSession = async (sessionId) => {
        this.setState({ deletingSession: sessionId });
        
        try {
          const response = await fetch(`/account/sessions/${sessionId}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          });
          
          const result = await response.json();
          
          if (result.success) {
            this.loadSessions(); // Refresh the list silently
          } else {
            alert(`Error: ${result.message}`);
          }
        } catch (error) {
          alert(`Error deleting session: ${error.message}`);
        } finally {
          this.setState({ deletingSession: null });
        }
      }

      render() {
        const { sessions, isLoading, error, isRevoking, deletingSession } = this.state;

        if (isLoading) {
          return <p>Loading sessions...</p>;
        }

        if (error) {
          return <p>Error loading sessions: {error.message}</p>;
        }

        return (
          <div>
            <div className="d-flex justify-content-between align-items-center mb-3">
              <h1>Active Sessions ({sessions.length})</h1>
              <button 
                className="btn btn-danger"
                onClick={this.revokeAllSessions}
                disabled={isRevoking || sessions.length === 0}
              >
                {isRevoking ? 'Revoking...' : 'Revoke All Sessions'}
              </button>
            </div>
            
            {sessions.length === 0 ? (
              <div className="alert alert-info">
                <i className="fas fa-info-circle"></i> No active sessions found.
              </div>
            ) : (
              <table className="table table-striped">
                <thead>
                  <tr>
                    <th>Session ID</th>
                    <th>User</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {sessions.map(session => (
                    <tr key={session.id}>
                      <td>
                        <code className="text-muted">{session.id}</code>
                      </td>
                      <td>
                        <strong>{session.username}</strong>
                      </td>
                      <td>{session.expiresAt}</td>
                      <td>
                        <span className={`badge ${session.status === 'active' ? 'badge-success' : 'badge-warning'}`}>
                          {session.status}
                        </span>
                      </td>
                      <td>
                        <button 
                          className="btn btn-sm btn-outline-danger"
                          onClick={() => this.deleteSession(session.id)}
                          disabled={deletingSession === session.id}
                          title="Delete this session"
                        >
                          {deletingSession === session.id ? (
                            React.createElement(React.Fragment, null, 
                              React.createElement("i", { className: "fas fa-spinner fa-spin" }), 
                              " Deleting..."
                            )
                          ) : (
                            React.createElement(React.Fragment, null, 
                              React.createElement("i", { className: "fas fa-trash" }), 
                              " Delete"
                            )
                          )}
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        );
      }
    }