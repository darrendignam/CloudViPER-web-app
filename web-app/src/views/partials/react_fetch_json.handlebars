  // Shared JSON fetch for every dashboard component.
  //
  // Calling response.json() without first checking response.ok is how a
  // perfectly ordinary event, the app restarting during a deploy, surfaced to
  // users as:
  //
  //     Unexpected token '<', "<!DOCTYPE "... is not valid JSON
  //
  // While the container is coming back, the proxy answers with an HTML error
  // page. The parse then fails on the first character of the markup, and the
  // message describes the symptom in terms of JSON syntax, which tells a user
  // nothing about what actually happened or that it will fix itself.
  //
  // Every component polls, so any component that parses blindly will show that
  // at least once per deploy.
  function fetchJson(url, options) {
    return fetch(url, Object.assign({ credentials: 'same-origin' }, options || {}))
      .then(function (response) {
        var contentType = response.headers.get('content-type') || '';

        if (!response.ok) {
          // A JSON body means the application answered and explained itself, so
          // prefer its message over anything invented here.
          if (contentType.indexOf('application/json') !== -1) {
            return response.json()
              .catch(function () { return {}; })
              .then(function (body) {
                throw new Error(body.error || body.message || ('Request failed (' + response.status + ')'));
              });
          }

          if (response.status === 502 || response.status === 503 || response.status === 504) {
            throw new Error('The server is restarting, retrying shortly');
          }

          throw new Error('Request failed (' + response.status + ')');
        }

        if (contentType.indexOf('application/json') === -1) {
          throw new Error('The server returned an unexpected response');
        }

        return response.json();
      });
  }

  // One event stream per page, shared by every component that wants live data.
  //
  // Polling meant each component asked independently on its own timer, so a
  // dashboard with three live panels made three requests every few seconds
  // whether or not anything had changed. EventSource reconnects on its own
  // after a drop, which is most of why this is not a raw WebSocket: the
  // traffic here only ever goes one way.
  var dashboardFeed = (function () {
    var source = null;
    var listeners = {};

    function ensure() {
      if (source) return source;
      source = new EventSource('/service/events', { withCredentials: true });
      Object.keys(listeners).forEach(bind);
      return source;
    }

    function bind(event) {
      source.addEventListener(event, function (message) {
        var payload;
        try { payload = JSON.parse(message.data); }
        catch (e) { return; }
        (listeners[event] || []).forEach(function (fn) { fn(payload); });
      });
    }

    return {
      on: function (event, handler) {
        var first = !listeners[event];
        listeners[event] = (listeners[event] || []).concat(handler);
        var s = ensure();
        if (first && s) bind(event);

        return function off() {
          listeners[event] = (listeners[event] || []).filter(function (fn) { return fn !== handler; });
        };
      }
    };
  })();

  // Pagination, shared rather than reimplemented per table.
  //
  // Rows accumulate faster than anyone expects: sessions in particular grow by
  // one per sign-in and are never pruned, so a list that was fine in testing
  // becomes hundreds of rows and an unusable page. usePage keeps the slicing
  // and the controls in one place so a table only has to say how big a page is.
  function paginate(rows, page, perPage) {
    var total = rows.length;
    var pages = Math.max(1, Math.ceil(total / perPage));
    var current = Math.min(Math.max(1, page), pages);
    var start = (current - 1) * perPage;

    return {
      rows: rows.slice(start, start + perPage),
      page: current,
      pages: pages,
      total: total,
      from: total === 0 ? 0 : start + 1,
      to: Math.min(start + perPage, total)
    };
  }

  function Pager(props) {
    var view = props.view;
    if (view.total === 0) return null;

    return (
      <div className="pager">
        <span className="pager-summary">
          Showing {view.from} to {view.to} of {view.total}
        </span>
        {view.pages > 1 && (
          <span className="pager-controls">
            <button type="button" className="btn btn-sm btn-outline-secondary"
              onClick={function () { props.onChange(view.page - 1); }}
              disabled={view.page <= 1}>Previous</button>
            <span className="pager-position">Page {view.page} of {view.pages}</span>
            <button type="button" className="btn btn-sm btn-outline-secondary"
              onClick={function () { props.onChange(view.page + 1); }}
              disabled={view.page >= view.pages}>Next</button>
          </span>
        )}
      </div>
    );
  }
