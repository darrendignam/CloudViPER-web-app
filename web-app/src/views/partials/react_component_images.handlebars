  class ImagePool extends React.Component {
    // Driven by props rather than page globals, so the same component serves
    // the standalone page and a dashboard tab without either knowing about the
    // other.
    isAdmin = () => this.props.userRole === 'admin';
    teamId = () => this.props.userTeamId || null;

    formatSize = (bytes) => {
      if (bytes === null || bytes === undefined) return 'unknown';
      const gb = bytes / (1024 * 1024 * 1024);
      return gb >= 1 ? gb.toFixed(2) + ' GB' : (bytes / (1024 * 1024)).toFixed(0) + ' MB';
    };

    constructor(props) {
      super(props);
      this.state = {
        images: [],
        loading: true,
        error: null,
        reference: '',
        name: '',
        description: '',
        busy: false,
        // Everything on the box, in a panel that stays shut until asked for.
        // It is a maintenance view, not part of the daily job of picking an
        // image, and it lists things that cannot be acted on at all.
        hostOpen: false,
        hostImages: [],
        hostLoading: false,
        hostError: null,
        hostPage: 1,
        // Per-image environment and mounts. Admin only, because both are host
        // access under a friendly name.
        editing: null,
        shareRoot: '',
        shares: [],
        editEnv: [],
        editVolumes: [],
        editError: null,
        editSaving: false
      };
    }

    componentDidMount() {
      this.fetchImages();
      // A pull is gigabytes and minutes, so the row appears first and the
      // status catches up. Polling is what turns that into a live list.
      this.poll = setInterval(() => {
        if (this.state.images.some(image => image.status === 'pending')) {
          this.fetchImages();
        }
      }, 4000);
    }

    componentWillUnmount() {
      clearInterval(this.poll);
    }

    toggleHostPanel = () => {
      const opening = !this.state.hostOpen;
      this.setState({ hostOpen: opening });
      if (opening) this.fetchHostImages();
    };

    fetchHostImages = () => {
      this.setState({ hostLoading: true, hostError: null });
      fetchJson('/images/api/host')
        .then(hostImages => this.setState({ hostImages, hostLoading: false }))
        .catch(error => this.setState({ hostError: error.message, hostLoading: false }));
    };

    addHostImageToPool = (entry) => {
      fetchJson('/images/api/pool', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reference: entry.reference, name: entry.reference })
      })
        .then(() => { this.fetchImages(); this.fetchHostImages(); })
        .catch(error => this.setState({ hostError: error.message }));
    };

    deleteHostImage = (entry) => {
      // Deliberately heavy. A ViPER image is around ten gigabytes and pulling
      // it again is minutes, so the size is named rather than left implicit.
      var size = this.formatSize(entry.sizeBytes);
      if (!window.confirm(
        'Delete ' + entry.reference + ' from this server?\n\n' +
        'This frees ' + size + ' and cannot be undone here. If it came from a ' +
        'registry it can be pulled again, which takes minutes for an image this ' +
        'size. If it was built here it is gone for good.'
      )) return;

      fetchJson('/images/api/host', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reference: entry.reference })
      })
        .then(() => this.fetchHostImages())
        .catch(error => this.setState({ hostError: error.message }));
    };

    openCustomise = (image) => {
      this.setState({
        editing: image,
        editError: null,
        editEnv: Object.entries(image.envVars || {}).map(([name, value]) => ({ name, value })),
        editVolumes: (image.volumes || []).map(v => Object.assign({}, v))
      });

      fetchJson('/images/api/shares')
        .then(payload => this.setState({ shares: payload.directories, shareRoot: payload.root }))
        .catch(error => this.setState({ editError: error.message }));
    };

    closeCustomise = () => this.setState({ editing: null, editError: null });

    addMount = (share) => {
      if (!share) return;
      const chosen = this.state.shares.find(s => s.hostPath === share);
      if (!chosen) return;

      this.setState(prev => ({
        editVolumes: prev.editVolumes.concat({
          hostPath: chosen.hostPath,
          containerPath: chosen.suggestedContainerPath,
          readOnly: true
        })
      }));
    };

    updateMount = (index, field, value) => {
      this.setState(prev => ({
        editVolumes: prev.editVolumes.map((mount, i) =>
          i === index ? Object.assign({}, mount, { [field]: value }) : mount)
      }));
    };

    removeMount = (index) => {
      this.setState(prev => ({ editVolumes: prev.editVolumes.filter((_, i) => i !== index) }));
    };

    updateEnv = (index, field, value) => {
      this.setState(prev => ({
        editEnv: prev.editEnv.map((entry, i) =>
          i === index ? Object.assign({}, entry, { [field]: value }) : entry)
      }));
    };

    saveCustomisation = () => {
      const { editing, editEnv, editVolumes } = this.state;
      const envVars = {};
      editEnv.forEach(entry => { if (entry.name.trim()) envVars[entry.name.trim()] = entry.value; });

      this.setState({ editSaving: true, editError: null });

      fetchJson('/images/api/pool/' + editing.id + '/customisation', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ envVars, volumes: editVolumes })
      })
        .then(() => {
          this.setState({ editing: null, editSaving: false });
          this.fetchImages();
        })
        .catch(error => this.setState({ editError: error.message, editSaving: false }));
    };

    fetchImages = () => {
      fetch('/images/api/pool', { credentials: 'same-origin' })
        .then(response => response.ok ? response.json() : Promise.reject(new Error('Could not load the image pool')))
        .then(images => this.setState({ images, loading: false, error: null }))
        .catch(error => this.setState({ error: error.message, loading: false }));
    };

    addImage = (event) => {
      event.preventDefault();
      const { reference, name, description } = this.state;
      this.setState({ busy: true, error: null });

      fetch('/images/api/pool', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ reference, name: name || reference, description })
      })
        .then(response => response.json().then(body => ({ ok: response.ok, body })))
        .then(({ ok, body }) => {
          if (!ok) throw new Error(body.error || 'Could not add that image');
          this.setState({ reference: '', name: '', description: '', busy: false });
          this.fetchImages();
        })
        .catch(error => this.setState({ error: error.message, busy: false }));
    };

    setDefault = (imageId) => {
      fetch('/images/api/pool/' + imageId + '/default', { method: 'POST', credentials: 'same-origin' })
        .then(response => response.json().then(body => ({ ok: response.ok, body })))
        .then(({ ok, body }) => {
          if (!ok) throw new Error(body.error || 'Could not set the default');
          this.fetchImages();
        })
        .catch(error => this.setState({ error: error.message }));
    };

    setTeamDefault = (imageId) => {
      fetch('/images/api/team/' + this.teamId() + '/default', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ imageId })
      })
        .then(response => response.json().then(body => ({ ok: response.ok, body })))
        .then(({ ok, body }) => {
          if (!ok) throw new Error(body.error || 'Could not set the team default');
          this.fetchImages();
        })
        .catch(error => this.setState({ error: error.message }));
    };

    removeImage = (image) => {
      // A committed image exists only on this appliance, so the confirmation
      // says so rather than asking the same question for both cases.
      const permanent = image.source === 'commit';
      const question = permanent
        ? 'This image was built here and exists nowhere else. Deleting it is permanent. Continue?'
        : 'Remove ' + image.reference + ' from the pool?';

      if (!window.confirm(question)) return;

      fetch('/images/api/pool/' + image.id, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ force: permanent })
      })
        .then(response => response.json().then(body => ({ ok: response.ok, body })))
        .then(({ ok, body }) => {
          if (!ok) throw new Error(body.error || 'Could not remove that image');
          this.fetchImages();
        })
        .catch(error => this.setState({ error: error.message }));
    };

    render() {
      const { images, loading, error, reference, name, description, busy,
              hostOpen, hostImages, hostLoading, hostError, hostPage,
              editing, shares, shareRoot, editEnv, editVolumes, editError, editSaving } = this.state;
      const hostView = paginate(hostImages, hostPage, 15);

      if (loading) return <p>Loading images...</p>;

      return (
        <div>
          {error && <div className="image-warning"><strong>Problem:</strong> {error}</div>}

          {this.isAdmin() && (
            <div className="image-warning">
              <strong>Adding an image runs someone else's code on this appliance.</strong>{' '}
              A reference is pulled and then launched as a desktop. Only add images you
              trust as much as you trust this server.
            </div>
          )}

          {this.isAdmin() && (
            <form className="image-form" onSubmit={this.addImage}>
              <h5>Add an image</h5>
              <div className="form-group">
                <label htmlFor="reference">Registry reference</label>
                <input id="reference" className="form-control" required
                  placeholder="ghcr.io/darrendignam/opf-cloud-viper:2.0.0-alpha"
                  value={reference}
                  onChange={(e) => this.setState({ reference: e.target.value })} />
              </div>
              <div className="form-group">
                <label htmlFor="name">Display name</label>
                <input id="name" className="form-control" placeholder="Defaults to the reference"
                  value={name}
                  onChange={(e) => this.setState({ name: e.target.value })} />
              </div>
              <div className="form-group">
                <label htmlFor="description">Description</label>
                <textarea id="description" className="form-control" rows="2"
                  value={description}
                  onChange={(e) => this.setState({ description: e.target.value })} />
              </div>
              <button className="btn btn-primary" type="submit" disabled={busy}>
                {busy ? 'Starting pull...' : 'Add and pull'}
              </button>
            </form>
          )}

          <h5>Pool ({images.length})</h5>
          {images.length === 0 && <p className="text-muted">No images yet. Instances use the configured default.</p>}

          {images.map(image => (
            <div key={image.id} className={'image-card' + (image.isGlobalDefault ? ' is-default' : '')}>
              <div className="d-flex justify-content-between align-items-start">
                <div>
                  <strong>{image.name}</strong>
                  {image.isGlobalDefault && <span className="ml-2 badge badge-secondary">System default</span>}
                  {image.source === 'commit' && <span className="ml-2 badge badge-info">Built here</span>}
                  <div className="image-ref">{image.reference}</div>
                  {image.description && <p className="mb-1 mt-1">{image.description}</p>}
                  <small className="text-muted">{this.formatSize(image.sizeBytes)}</small>
                  {(image.volumes || []).length > 0 && (
                    <div className="image-extras">
                      {image.volumes.map(mount => (
                        <span key={mount.containerPath} className="image-extra">
                          {mount.containerPath}{mount.readOnly ? ' (read only)' : ' (writable)'}
                        </span>
                      ))}
                    </div>
                  )}
                  {Object.keys(image.envVars || {}).length > 0 && (
                    <div className="image-extras">
                      {Object.keys(image.envVars).map(key => (
                        <span key={key} className="image-extra">{key}</span>
                      ))}
                    </div>
                  )}
                </div>
                <span className={'image-status status-' + image.status}>{image.status}</span>
              </div>

              {image.status === 'failed' && image.statusMessage && (
                <p className="mt-2 mb-0"><small className="text-danger">{image.statusMessage}</small></p>
              )}

              <div className="mt-2">
                {this.isAdmin() && image.status === 'available' && !image.isGlobalDefault && (
                  <button className="btn btn-sm btn-outline-primary mr-2"
                    onClick={() => this.setDefault(image.id)}>Make system default</button>
                )}
                {this.teamId() && image.status === 'available' && (
                  <button className="btn btn-sm btn-outline-secondary mr-2"
                    onClick={() => this.setTeamDefault(image.id)}>Use for my team</button>
                )}
                {this.isAdmin() && image.status === 'available' && (
                  <button className="btn btn-sm btn-outline-secondary mr-2"
                    onClick={() => this.openCustomise(image)}>Files and settings</button>
                )}
                {this.isAdmin() && (
                  <button className="btn btn-sm btn-outline-danger"
                    onClick={() => this.removeImage(image)}>Remove</button>
                )}
              </div>
            </div>
          ))}

          {editing && (
            <div className="instance-details-overlay" onClick={this.closeCustomise}>
              <div className="instance-details-modal" onClick={(e) => e.stopPropagation()}>
                <div className="modal-header">
                  <h3>Files and settings: {editing.name}</h3>
                  <button className="btn btn-sm btn-secondary" onClick={this.closeCustomise}>Close</button>
                </div>

                <div className="modal-body">
                  <p className="text-muted">
                    Applied to every desktop launched from this image. Existing desktops
                    are unaffected; changes take effect on the next launch.
                  </p>

                  <h5>Shared files</h5>
                  <p className="text-muted small">
                    Offered from <code>{shareRoot}</code> on the server. Mount a network
                    share there on the host and it appears in this list, without anything
                    being copied or built into the image.
                  </p>

                  {shares.length === 0 ? (
                    <p className="text-muted">
                      Nothing has been placed in <code>{shareRoot}</code> yet.
                    </p>
                  ) : (
                    <select className="form-control form-control-sm mb-2"
                      value=""
                      onChange={(e) => this.addMount(e.target.value)}>
                      <option value="">Add a shared folder...</option>
                      {shares.map(share => (
                        <option key={share.hostPath} value={share.hostPath}>
                          {share.name}{share.entryCount !== null ? ' (' + share.entryCount + ' items)' : ''}
                        </option>
                      ))}
                    </select>
                  )}

                  {editVolumes.length > 0 && (
                    <table className="table table-sm">
                      <thead>
                        <tr><th>On the server</th><th>Inside the desktop</th><th>Access</th><th></th></tr>
                      </thead>
                      <tbody>
                        {editVolumes.map((mount, index) => (
                          <tr key={index}>
                            <td className="image-ref">{mount.hostPath}</td>
                            <td>
                              <input className="form-control form-control-sm"
                                value={mount.containerPath}
                                onChange={(e) => this.updateMount(index, 'containerPath', e.target.value)} />
                            </td>
                            <td>
                              <select className="form-control form-control-sm"
                                value={mount.readOnly ? 'ro' : 'rw'}
                                onChange={(e) => this.updateMount(index, 'readOnly', e.target.value === 'ro')}>
                                <option value="ro">Read only</option>
                                <option value="rw">Writable</option>
                              </select>
                            </td>
                            <td>
                              <button className="btn btn-sm btn-outline-danger"
                                onClick={() => this.removeMount(index)}>Remove</button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}

                  {editVolumes.some(mount => !mount.readOnly) && (
                    <div className="image-warning">
                      A writable share is shared by every desktop launched from this image.
                      One user changing a file changes it for everyone, and nothing here
                      records who did.
                    </div>
                  )}

                  <h5 className="mt-4">Environment variables</h5>
                  <p className="text-muted small">
                    Anything the platform sets for itself is refused, so a variable cannot
                    be used to reach into another desktop.
                  </p>

                  {editEnv.map((entry, index) => (
                    <div className="env-row" key={index}>
                      <input className="form-control form-control-sm" placeholder="NAME"
                        value={entry.name}
                        onChange={(e) => this.updateEnv(index, 'name', e.target.value)} />
                      <input className="form-control form-control-sm" placeholder="value"
                        value={entry.value}
                        onChange={(e) => this.updateEnv(index, 'value', e.target.value)} />
                      <button className="btn btn-sm btn-outline-danger"
                        onClick={() => this.setState(prev => ({ editEnv: prev.editEnv.filter((_, i) => i !== index) }))}>
                        Remove
                      </button>
                    </div>
                  ))}

                  <button className="btn btn-sm btn-outline-secondary mt-2"
                    onClick={() => this.setState(prev => ({ editEnv: prev.editEnv.concat({ name: '', value: '' }) }))}>
                    Add a variable
                  </button>

                  {editError && <div className="image-warning mt-3">{editError}</div>}
                </div>

                <div className="modal-footer">
                  <button className="btn btn-secondary" onClick={this.closeCustomise} disabled={editSaving}>Cancel</button>
                  <button className="btn btn-primary" onClick={this.saveCustomisation} disabled={editSaving}>
                    {editSaving ? 'Saving...' : 'Save'}
                  </button>
                </div>
              </div>
            </div>
          )}

          {this.isAdmin() && (
            <div className="host-images">
              <button type="button" className="host-images-toggle" onClick={this.toggleHostPanel}>
                <i className={'fas fa-chevron-' + (hostOpen ? 'down' : 'right')}></i>{' '}
                Images on this server
                {hostImages.length > 0 && <span className="host-images-count">{hostImages.length}</span>}
              </button>

              {hostOpen && (
                <div className="host-images-body">
                  <p className="text-muted host-images-intro">
                    Everything Docker holds on this box, including images that cannot be
                    touched. They still occupy disk, so they are shown rather than hidden.
                  </p>

                  {hostError && <div className="image-warning">{hostError}</div>}
                  {hostLoading && <p>Reading images from the server...</p>}

                  {!hostLoading && (
                    <div>
                      <table className="table table-sm host-images-table">
                        <thead>
                          <tr><th>Reference</th><th>Size</th><th>State</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                          {hostView.rows.map(entry => (
                            <tr key={entry.reference}>
                              <td className="image-ref">{entry.reference}</td>
                              <td>{this.formatSize(entry.sizeBytes)}</td>
                              <td>
                                {entry.blocked && <span className="host-tag is-blocked">platform</span>}
                                {entry.inPool && <span className="host-tag is-pooled">in pool</span>}
                                {entry.inUse && <span className="host-tag is-inuse">in use</span>}
                                {!entry.blocked && !entry.inPool && !entry.inUse && <span className="text-muted">unused</span>}
                              </td>
                              <td>
                                {!entry.inPool && !entry.blocked && (
                                  <button className="btn btn-sm btn-outline-primary mr-2"
                                    onClick={() => this.addHostImageToPool(entry)}>Add to pool</button>
                                )}
                                {!entry.inPool && !entry.blocked && !entry.inUse && (
                                  <button className="btn btn-sm btn-outline-danger"
                                    onClick={() => this.deleteHostImage(entry)}>Delete</button>
                                )}
                                {entry.blocked && <span className="text-muted">the platform needs this</span>}
                                {entry.inPool && <span className="text-muted">manage it above</span>}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <Pager view={hostView} onChange={(next) => this.setState({ hostPage: next })} />
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      );
    }
  }
