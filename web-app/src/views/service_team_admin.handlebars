<div id="react-root" class="bg-white"></div>

<!-- Add React, ReactDOM, and Babel scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.development.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.development.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/6.25.0/babel.min.js"></script>

<style>
/* Team Admin specific styling */
.team-admin-dashboard {
  padding: 2rem;
}

.admin-tabs {
  display: flex;
  gap: 0.5rem;
  border-bottom: 2px solid #dee2e6;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.admin-tab {
  padding: 1rem 1.5rem;
  background: transparent;
  border: none;
  color: #6c757d;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.3s ease;
  border-bottom: 3px solid transparent;
}

.admin-tab:hover {
  color: #495057;
  background: #f8f9fa;
}

.admin-tab.active {
  color: #007bff;
  border-bottom-color: #007bff;
  background: #f8f9fa;
}

.admin-tab-icon {
  margin-right: 0.5rem;
  font-size: 1.1rem;
  vertical-align: middle;
  display: inline-block;
  width: 20px;
  text-align: center;
}

.team-info-prompt {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12px;
  padding: 1.5rem;
  margin-top: 1rem;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

.team-info-content {
  color: white;
}

.team-info-content h4 {
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.team-info-content p {
  margin: 0;
  opacity: 0.9;
}
</style>

<script type="text/babel">
  {{> react_component_users }}
  {{> react_component_viperinstances }}
  {{> react_component_images }}

  class TeamAdminDashboard extends React.Component {
    constructor(props) {
      super(props);
      
      this.availableTabs = ['users', 'instances'];
      
      this.state = {
        activeTab: this.getInitialTab()
      };
    }

    componentDidMount() {
      window.addEventListener('hashchange', this.handleHashChange);
    }

    componentWillUnmount() {
      window.removeEventListener('hashchange', this.handleHashChange);
    }

    getInitialTab = () => {
      const hash = window.location.hash.substring(1);
      return this.availableTabs.includes(hash) ? hash : 'users';
    }

    handleHashChange = () => {
      const newTab = this.getInitialTab();
      if (newTab !== this.state.activeTab) {
        this.setState({ activeTab: newTab });
      }
    }

    switchTab = (tabName) => {
      this.setState({ activeTab: tabName });
      window.location.hash = tabName;
    }

    render() {
      const { activeTab } = this.state;
      const userEmail = '{{{user.email}}}';
      const userRole = '{{{user.role}}}';
      const userTeam = '{{{user.team}}}' || null;
      const userTeamId = {{#if user.teamId}}{{{user.teamId}}}{{else}}null{{/if}};

      const tabs = [
        {
          id: 'users',
          label: 'Team Members',
          icon: 'fas fa-users',
          component: <UserList userRole={userRole} userTeam={userTeam} currentUserId={'{{{user.id}}}'} />,
          description: 'Manage your team members and invite new users'
        },
        {
          id: 'images',
          label: 'Container Images',
          icon: 'fas fa-layer-group',
          component: <ImagePool userRole={userRole} userTeamId={userTeamId} />,
          description: 'Choose the default image for your team'
        },
        {
          id: 'instances',
          label: 'Team Instances',
          icon: 'fas fa-server',
          component: <ViPERInstanceList userRole={userRole} userEmail={userEmail} />,
          description: 'View and manage all ViPER instances for your team'
        }
      ];

      return (
        <div className="team-admin-dashboard">
          <div className="admin-tabs">
            {tabs.map(tab => (
              <button
                key={tab.id}
                className={`admin-tab ${activeTab === tab.id ? 'active' : ''}`}
                onClick={() => this.switchTab(tab.id)}
              >
                <i className={`admin-tab-icon ${tab.icon}`}></i>
                {tab.label}
              </button>
            ))}
          </div>

          <div className="admin-tab-content">
            {tabs.map(tab => (
              <div
                key={tab.id}
                className={`admin-panel ${activeTab === tab.id ? 'active' : ''}`}
                style=\{{ display: activeTab === tab.id ? 'block' : 'none' }}
              >
                <div className="panel-header">
                  <h2 className="panel-title">
                    <i className={tab.icon}></i> {tab.label}
                  </h2>
                  <p className="panel-subtitle">{tab.description}</p>
                </div>
                {tab.component}
              </div>
            ))}
          </div>
        </div>
      );
    }
  }

  ReactDOM.render(<TeamAdminDashboard />, document.getElementById('react-root'));
</script>
