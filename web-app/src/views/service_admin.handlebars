<script type="text/babel">
  {{> react_fetch_json }}

    {{> react_component_users }}
    {{> react_component_sessions }}
    {{> react_component_viperinstances }}
    {{> react_component_logs }}
    {{> react_component_health }}
    {{> react_component_statistics }}
    {{> react_component_images }}

    class AdminDashboard extends React.Component {
        constructor(props) {
            super(props);
            
            // Define available tabs
            this.availableTabs = ['users', 'sessions', 'instances', 'health', 'statistics', 'logs'];
            
            this.state = {
                activeTab: this.getInitialTab()
            };
        }

        componentDidMount() {
            // Listen for hash changes (browser back/forward navigation)
            window.addEventListener('hashchange', this.handleHashChange);
        }

        componentWillUnmount() {
            // Clean up event listener
            window.removeEventListener('hashchange', this.handleHashChange);
        }

        getInitialTab = () => {
            // Get tab from URL hash, fallback to 'users' if invalid
            const hash = window.location.hash.substring(1); // Remove the # symbol
            return this.availableTabs.includes(hash) ? hash : 'users';
        }

        handleHashChange = () => {
            // Update active tab when hash changes (e.g., browser navigation)
            const newTab = this.getInitialTab();
            if (newTab !== this.state.activeTab) {
                this.setState({ activeTab: newTab });
            }
        }

        switchTab = (tabName) => {
            // Update both state and URL hash
            this.setState({ activeTab: tabName });
            
            // Update URL hash without triggering page reload
            if (window.location.hash !== `#${tabName}`) {
                window.history.pushState(null, null, `#${tabName}`);
            }
        }

        render() {
            const { activeTab } = this.state;
            
            // Get user info from the template context
            const userEmail = '{{{user.email}}}';
            const userRole = '{{{user.role}}}';
            const userTeam = '{{{user.team}}}' || null;
            const userTeamId = {{#if user.teamId}}{{{user.teamId}}}{{else}}null{{/if}};

            const tabs = [
                {
                    id: 'users',
                    label: 'User Management',
                    icon: 'fas fa-users',
                    component: <UserList userRole={userRole} userTeam={userTeam} />,
                    description: 'Manage user accounts, roles, and permissions'
                },
                {
                    id: 'sessions',
                    label: 'Active Sessions',
                    icon: 'fas fa-lock',
                    component: <SessionList />,
                    description: 'Monitor and manage user sessions'
                },
                {
                    id: 'instances',
                    label: 'ViPER Instances',
                    icon: 'fas fa-server',
                    component: <ViPERInstanceList userRole={userRole} userEmail={userEmail} />,
                    description: 'Monitor and manage ViPER container instances'
                },
                {
                    id: 'health',
                    label: 'System Health',
                    icon: 'fas fa-heartbeat',
                    component: <SystemHealth />,
                    description: 'Monitor system health and component status'
                },
                {
                    id: 'statistics',
                    label: 'Statistics',
                    icon: 'fas fa-chart-bar',
                    component: <SystemStatistics />,
                    description: 'View detailed system usage and performance statistics'
                },
                {
                    id: 'images',
                    label: 'Container Images',
                    icon: 'fas fa-layer-group',
                    component: <ImagePool userRole={userRole} userTeamId={userTeamId} />,
                    description: 'Manage the pool of images instances are launched from'
                },
                {
                    id: 'logs',
                    label: 'System Logs',
                    icon: 'fas fa-chart-line',
                    component: <LogViewer />,
                    description: 'View and analyze system, session, and database logs'
                }
            ];

            return (
                <div className="admin-dashboard">
                    {/* Tab Navigation */}
                    <div className="admin-tabs">
                        {tabs.map(tab => (
                            <button
                                key={tab.id}
                                className={`admin-tab ${activeTab === tab.id ? 'active' : ''}`}
                                onClick={() => this.switchTab(tab.id)}
                            >
                                <i className={`admin-tab-icon ${tab.icon}`}></i>
                                {tab.label}
                            </button>
                        ))}
                    </div>

                    {/* Tab Content */}
                    <div className="admin-tab-content">
                        {tabs.map(tab => (
                            <div
                                key={tab.id}
                                className={`admin-panel ${activeTab === tab.id ? 'active' : ''}`}
                            >
                                <div className="panel-header">
                                    <div>
                                        <h2 className="panel-title">
                                            <i className={`admin-tab-icon ${tab.icon}`}></i>
                                            {tab.label}
                                        </h2>
                                        <p className="panel-subtitle">{tab.description}</p>
                                    </div>
                                </div>
                                <div className="panel-body">
                                    {tab.component}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }
    }

    // Use React 18 createRoot API
    const container = document.getElementById('react-root');
    const root = ReactDOM.createRoot ? ReactDOM.createRoot(container) : ReactDOM.render(<AdminDashboard />, container);
    if (ReactDOM.createRoot) {
        root.render(<AdminDashboard />);
    }
    console.log('Admin Dashboard rendered successfully');
</script>