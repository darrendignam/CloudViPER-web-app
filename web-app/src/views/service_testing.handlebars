<!-- Cloud GUI Styling for Testing Account -->
<div class="login-cloud">
  <div class="login-content">
    <div class="login-header">
      <div class="login-icon">
        <i class="fas fa-flask"></i>
      </div>
      <h1 class="login-title">ViPER Testing Environment</h1>
      <p class="login-subtitle">Welcome to your testing dashboard, {{{user.email}}}</p>
    </div>

    <div class="info-section">
      <div class="info-card">
        <div class="info-icon">
          <i class="fas fa-info-circle"></i>
        </div>
        <div class="info-content">
          <h3>Testing Account Features</h3>
          <p>As a testing user, you can create and manage a single ViPER instance for evaluation purposes.</p>
          <ul>
            <li><i class="fas fa-check text-success"></i> Create one ViPER container instance</li>
            <li><i class="fas fa-check text-success"></i> Access to core ViPER functionality</li>
            <li><i class="fas fa-check text-success"></i> Full testing environment</li>
            <li><i class="fas fa-times text-muted"></i> Limited to one concurrent instance</li>
          </ul>
        </div>
      </div>

      <div class="upgrade-prompt">
        <div class="upgrade-content">
          <h4><i class="fas fa-arrow-up"></i> Ready to upgrade?</h4>
          <p>Contact our team to upgrade to a Member or Subscriber account for additional features and capacity.</p>
          <a href="mailto:admin@cloudviper.org?subject=Account Upgrade Request&body=Hello,%0D%0A%0D%0AI would like to upgrade my testing account ({{{user.email}}}) to access more features.%0D%0A%0D%0AThank you!" 
             class="btn btn-primary">
            <i class="fas fa-envelope"></i> Request Upgrade
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="react-root" class="container-fluid mt-4"></div>


  <!-- Add React, ReactDOM, and Babel scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.development.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.development.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/6.25.0/babel.min.js"></script>

  <style>
  /* Cloud GUI Enhanced Styling for ViPER Instances */
  .viper-instances-container {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    padding: 2rem;
    margin: 1rem 0;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .instances-header {
    color: white;
    text-align: center;
    margin-bottom: 2rem;
  }

  .instances-header h2 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .instances-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .instance-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .instance-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .instance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .instance-status {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-active {
    background: #d4edda;
    color: #155724;
  }

  .status-created {
    background: #fff3cd;
    color: #856404;
  }

  .status-error {
    background: #f8d7da;
    color: #721c24;
  }

  .new-instance-card {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: 2px dashed rgba(255, 255, 255, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .new-instance-card:hover {
    background: linear-gradient(135deg, #764ba2, #667eea);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .new-instance-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .instance-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .btn-cloud {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-cloud:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    color: white;
    text-decoration: none;
  }

  .btn-danger-cloud {
    background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  }

  .btn-danger-cloud:hover {
    box-shadow: 0 4px 15px rgba(255, 107, 107, 0.4);
  }

  .empty-state {
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    padding: 3rem;
  }

  .empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.6;
  }

  .loading-spinner {
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
    padding: 2rem;
  }

  .loading-spinner i {
    font-size: 2rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  </style>

  <script type="text/babel">
  {{> react_fetch_json }}


    {{> react_component_viperinstances }}

    class App extends React.Component {
      render() {
        return (
          <div className="viper-instances-container">
            <div className="instances-header">
              <h2><i className="fas fa-server"></i> Your ViPER Instances</h2>
              <p>Manage your testing environment containers</p>
            </div>
            <ViPERInstanceList />
          </div>
        );
      }
    }

    ReactDOM.render(<App />, document.getElementById('react-root'));
  </script>