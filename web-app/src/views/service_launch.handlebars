<div class="viper-launch" data-instance-uuid="{{instanceUUID}}">
    <div class="viper-launch-bar">
        <span class="viper-launch-title">{{instanceName}}</span>
        <span class="viper-launch-status" id="connection-status">Requesting access</span>
        <button type="button" class="viper-launch-action" id="fullscreen-button" disabled>
            <span aria-hidden="true">&#9974;</span> Fullscreen
        </button>
        <button type="button" class="viper-launch-action" id="popout-button" disabled>
            <span aria-hidden="true">&#8599;</span> Open in new tab
        </button>
        <a class="viper-launch-back" href="/service">Back to instances</a>
    </div>

    <div class="viper-launch-warning" id="popout-warning" hidden>
        <strong>Opening in a new tab puts the access token in the address bar.</strong>
        It will then be visible on screen, saved in browser history, and carried
        in anything you copy or share from that tab. The framed desktop exists to
        avoid exactly that. Anyone who reads the token can drive this desktop
        until it is revoked.
        <div class="viper-launch-warning-actions">
            <button type="button" class="viper-launch-action is-confirm" id="popout-confirm">Open anyway</button>
            <button type="button" class="viper-launch-action" id="popout-cancel">Cancel</button>
        </div>
    </div>
    <iframe
        id="viper-frame"
        class="viper-launch-frame"
        title="ViPER desktop"
        allow="fullscreen; clipboard-read; clipboard-write"></iframe>
</div>

<script>
    (function () {
        // The token is fetched over POST and written straight onto the iframe,
        // so it never enters the address bar, browser history, or a copied URL.
        var container = document.querySelector('.viper-launch');
        var status = document.getElementById('connection-status');
        var frame = document.getElementById('viper-frame');
        var uuid = container.getAttribute('data-instance-uuid');
        var settled = false;
        var desktopUrl = null;

        function fail(message) {
            settled = true;
            status.textContent = message;
            status.classList.add('is-error');
        }

        // A load event only says a document arrived. A proxy 502 while the
        // container starts, or a Selkies close for a bad token, both load a
        // document, so the frame would report Connected over a blank screen.
        //
        // The instance cannot be probed from here: it is a different origin, so
        // the request would have to be no-cors, and an opaque response resolves
        // on a 502 exactly as it does on a 200. The app probes it server side
        // instead and this endpoint, being same-origin, can be read properly.
        function confirmReachable() {
            var deadline = Date.now() + 120000;

            (function poll() {
                if (settled) return;

                fetch('/service/launch/' + encodeURIComponent(uuid) + '/ready', {
                    credentials: 'same-origin',
                    cache: 'no-store'
                }).then(function (response) {
                    return response.ok ? response.json() : { reachable: false };
                }).catch(function () {
                    return { reachable: false };
                }).then(function (body) {
                    if (settled) return;

                    if (body.reachable) {
                        settled = true;
                        status.textContent = 'Connected';
                        status.classList.add('is-connected');
                        return;
                    }

                    if (Date.now() > deadline) {
                        fail('The desktop is not responding');
                        return;
                    }

                    window.setTimeout(poll, 2000);
                });
            })();
        }

        fetch('/service/launch/' + encodeURIComponent(uuid) + '/token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin'
        }).then(function (response) {
            if (!response.ok) {
                return response.json().catch(function () { return {}; }).then(function (body) {
                    throw new Error(body.error || 'Could not get access to this instance');
                });
            }
            return response.json();
        }).then(function (body) {
            status.textContent = body.role === 'viewer' ? 'Connecting, view only' : 'Connecting';
            desktopUrl = body.url;
            frame.src = body.url;
            document.getElementById('fullscreen-button').disabled = false;
            document.getElementById('popout-button').disabled = false;
            confirmReachable();
        }).catch(function (error) {
            fail(error.message);
        });

        window.setTimeout(function () {
            if (!settled) {
                status.textContent = 'Still connecting, this can take a moment on first start';
            }
        }, 15000);

        // Fullscreen keeps the token where it is. The browser exits on Escape
        // and says so itself, so there is no need to explain it here, but the
        // button still has to track the state or it lies about what it does.
        var fullscreenButton = document.getElementById('fullscreen-button');

        fullscreenButton.addEventListener('click', function () {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else if (container.requestFullscreen) {
                container.requestFullscreen().catch(function () {
                    status.textContent = 'This browser refused fullscreen';
                });
            }
        });

        document.addEventListener('fullscreenchange', function () {
            fullscreenButton.innerHTML = document.fullscreenElement
                ? '<span aria-hidden="true">&#9974;</span> Exit fullscreen'
                : '<span aria-hidden="true">&#9974;</span> Fullscreen';
        });

        // Popping out trades the whole point of the frame for a resizable
        // window, so it asks first rather than assuming.
        var popoutButton = document.getElementById('popout-button');
        var popoutWarning = document.getElementById('popout-warning');

        popoutButton.addEventListener('click', function () {
            popoutWarning.hidden = false;
        });

        document.getElementById('popout-cancel').addEventListener('click', function () {
            popoutWarning.hidden = true;
        });

        document.getElementById('popout-confirm').addEventListener('click', function () {
            popoutWarning.hidden = true;
            if (!desktopUrl) return;
            // noopener so the new tab cannot reach back into this one through
            // window.opener, which would hand it the session it was opened from.
            window.open(desktopUrl, '_blank', 'noopener');
        });
    })();
</script>
