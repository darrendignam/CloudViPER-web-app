<div class="viper-launch" data-instance-uuid="{{instanceUUID}}">
    <div class="viper-launch-bar">
        <span class="viper-launch-title">{{instanceName}}</span>
        <span class="viper-launch-status" id="connection-status">Requesting access</span>
        <a class="viper-launch-back" href="/service">Back to instances</a>
    </div>
    <iframe
        id="viper-frame"
        class="viper-launch-frame"
        title="ViPER desktop"
        allow="fullscreen; clipboard-read; clipboard-write"></iframe>
</div>

<script>
    (function () {
        // The token is fetched over POST and written straight onto the iframe,
        // so it never enters the address bar, browser history, or a copied URL.
        var container = document.querySelector('.viper-launch');
        var status = document.getElementById('connection-status');
        var frame = document.getElementById('viper-frame');
        var uuid = container.getAttribute('data-instance-uuid');
        var settled = false;

        function fail(message) {
            settled = true;
            status.textContent = message;
            status.classList.add('is-error');
        }

        // A load event only says a document arrived. A proxy 502 while the
        // container starts, or a Selkies close for a bad token, both load a
        // document, so the frame would report Connected over a blank screen.
        // Ask the instance directly instead.
        function confirmReachable(instanceUrl) {
            var origin = new URL(instanceUrl).origin;
            var deadline = Date.now() + 120000;

            (function poll() {
                if (settled) return;

                fetch(origin + '/favicon.ico', { mode: 'no-cors', cache: 'no-store' })
                    .then(function () {
                        settled = true;
                        status.textContent = 'Connected';
                        status.classList.add('is-connected');
                    })
                    .catch(function () {
                        if (Date.now() > deadline) {
                            fail('The desktop is not responding');
                            return;
                        }
                        window.setTimeout(poll, 2000);
                    });
            })();
        }

        fetch('/service/launch/' + encodeURIComponent(uuid) + '/token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin'
        }).then(function (response) {
            if (!response.ok) {
                return response.json().catch(function () { return {}; }).then(function (body) {
                    throw new Error(body.error || 'Could not get access to this instance');
                });
            }
            return response.json();
        }).then(function (body) {
            status.textContent = body.role === 'viewer' ? 'Connecting, view only' : 'Connecting';
            frame.src = body.url;
            confirmReachable(body.url);
        }).catch(function (error) {
            fail(error.message);
        });

        window.setTimeout(function () {
            if (!settled) {
                status.textContent = 'Still connecting, this can take a moment on first start';
            }
        }, 15000);
    })();
</script>
