# Secrets. The Dockerfile copies all of web-app/src, which includes src/.env on
# a developer's machine. CI never sees it because it is gitignored, so a locally
# built image would differ from the published one by having credentials in it.
**/.env
**/.env.*

# Rebuilt inside the image by `npm run build`
**/node_modules
web-app/dist

# Runtime state, not source. The MySQL data directory is owned by the database
# container's user and is unreadable by the daemon building the image, so
# leaving it in the context fails the build outright with a permission error on
# files like #innodb_redo, rather than merely wasting time tarring gigabytes.
volumes/
web-app/logs/

# 190MB of test corpora shipped to instances at runtime, never built in.
web-app/src/public/files/

# Not part of the application
.git
.github
docs
Documentation
reports
image-security
k8s-aws
*.png
*.md
